{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://beepboop.kjanat.dev/schema/v1.json",
	"title": "Repository release automation",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"extends": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^github>([\\w.-]+\\/[\\w.-]+):([\\w-]+)(?:#([\\w./-]+))?$"
			}
		},
		"managers": {
			"default": [
				"pre-commit",
				"cargo",
				"npm",
				"jsr",
				"github-release",
				"oci",
				"goreleaser",
				"go",
				"vscode",
				"manifest",
				"workflow"
			],
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"pre-commit",
					"cargo",
					"npm",
					"jsr",
					"github-release",
					"oci",
					"goreleaser",
					"go",
					"vscode",
					"manifest",
					"workflow"
				]
			}
		},
		"streams": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{0,63}$"
			},
			"additionalProperties": {
				"$ref": "#/$defs/stream"
			}
		},
		"subscriptions": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/subscription"
			}
		},
		"winget": {
			"type": "object",
			"properties": {
				"config": {
					"type": "string",
					"pattern": "^[\\w./-]+\\.json$",
					"description": "Path to WinGet package JSON in the release commit"
				},
				"tagPrefix": {
					"default": "v",
					"type": "string",
					"pattern": "^[\\w.-]*$"
				},
				"automatic": {
					"default": false,
					"type": "boolean"
				}
			},
			"required": [
				"config"
			],
			"additionalProperties": false
		}
	},
	"additionalProperties": false,
	"$defs": {
		"stream": {
			"type": "object",
			"properties": {
				"versioning": {
					"default": "workspace",
					"type": "string",
					"enum": [
						"workspace",
						"independent",
						"none"
					]
				},
				"versionFiles": {
					"type": "array",
					"items": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "json"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1
												},
												{
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												}
											]
										}
									}
								},
								"required": [
									"path",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "yaml"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1
												},
												{
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												}
											]
										}
									}
								},
								"required": [
									"path",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "toml"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"type": "string",
											"pattern": "^[A-Za-z0-9_-]+$"
										}
									}
								},
								"required": [
									"path",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "text"
									},
									"prefix": {
										"type": "string",
										"minLength": 1
									},
									"suffix": {
										"type": "string",
										"minLength": 1
									}
								},
								"required": [
									"path",
									"format",
									"prefix",
									"suffix"
								],
								"additionalProperties": false
							}
						]
					}
				},
				"versionSource": {
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "tags"
						},
						"prefix": {
							"type": "string",
							"pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]*$"
						}
					},
					"required": [
						"kind",
						"prefix"
					],
					"additionalProperties": false
				},
				"packages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/packageReference"
					}
				},
				"prepare": {
					"type": "object",
					"properties": {
						"version": {
							"type": "string",
							"const": "manual"
						},
						"workflow": {
							"$ref": "#/$defs/workflow"
						},
						"strategy": {
							"type": "string",
							"enum": [
								"managed",
								"workflow"
							]
						}
					},
					"additionalProperties": false
				},
				"promote": {
					"type": "object",
					"properties": {
						"approval": {
							"default": "required",
							"type": "string",
							"enum": [
								"required",
								"merge",
								"push"
							]
						},
						"workflow": {
							"$ref": "#/$defs/workflow"
						}
					},
					"additionalProperties": false
				},
				"workflows": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{0,63}$"
					},
					"additionalProperties": {
						"$ref": "#/$defs/workflow"
					}
				},
				"required": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/packageReference"
					}
				},
				"credentials": {
					"default": [],
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"channels": {
					"default": {
						"stable": "latest",
						"prerelease": "next"
					},
					"type": "object",
					"properties": {
						"stable": {
							"default": "latest",
							"type": "string",
							"minLength": 1
						},
						"prerelease": {
							"default": "next",
							"type": "string",
							"minLength": 1
						}
					},
					"additionalProperties": false
				},
				"concurrency": {
					"default": "queue",
					"type": "string",
					"enum": [
						"queue",
						"supersede-pending"
					]
				}
			},
			"additionalProperties": false
		},
		"packageReference": {
			"description": "Package URL (versionless for release selection). Legacy manager:name references are accepted for compatibility.",
			"type": "string",
			"minLength": 1
		},
		"workflow": {
			"type": "object",
			"properties": {
				"file": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]+\\.ya?ml$"
				},
				"ref": {
					"type": "string",
					"pattern": "^(?:refs\\/(?:heads|tags)\\/)?[A-Za-z0-9][A-Za-z0-9._/-]*\\*?$"
				},
				"inputs": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": [
							"string",
							"boolean",
							"number"
						]
					}
				},
				"required": {
					"type": "boolean"
				},
				"needs": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"schedule": {
					"type": "string",
					"minLength": 1
				},
				"publications": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/packageReference"
					}
				},
				"mode": {
					"type": "string",
					"enum": [
						"observe",
						"dispatch"
					]
				},
				"each": {
					"type": "string",
					"const": "package"
				},
				"refs": {
					"type": "object",
					"properties": {
						"phase": {
							"type": "string",
							"enum": [
								"version",
								"aliases"
							]
						},
						"prefix": {
							"default": "v",
							"type": "string",
							"pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]*$"
						},
						"aliases": {
							"default": [],
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"major",
									"minor"
								]
							}
						},
						"signed": {
							"type": "boolean"
						}
					},
					"required": [
						"phase"
					],
					"additionalProperties": false
				},
				"platform": {
					"type": "object",
					"properties": {
						"os": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						},
						"arch": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						},
						"abi": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						}
					},
					"required": [
						"os",
						"arch"
					],
					"additionalProperties": false
				},
				"outputs": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"kind": {
								"type": "string",
								"enum": [
									"archive",
									"binary",
									"manifest",
									"package",
									"checksums"
								]
							}
						},
						"required": [
							"id",
							"kind"
						],
						"additionalProperties": false
					}
				},
				"artifactInputs": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"operation": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"output": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							}
						},
						"required": [
							"operation",
							"output"
						],
						"additionalProperties": false
					}
				}
			},
			"required": [
				"file"
			],
			"additionalProperties": false
		},
		"subscription": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{0,63}$"
						},
						"source": {
							"type": "string",
							"minLength": 1
						},
						"stream": {
							"type": "string",
							"minLength": 1
						},
						"operation": {
							"type": "string",
							"minLength": 1
						},
						"event": {
							"type": "string",
							"const": "release"
						},
						"sourceStream": {
							"type": "string",
							"minLength": 1
						},
						"sourceGroup": {
							"type": "string",
							"minLength": 1
						},
						"publication": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": [
						"id",
						"source",
						"stream",
						"operation",
						"event"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{0,63}$"
						},
						"source": {
							"type": "string",
							"minLength": 1
						},
						"stream": {
							"type": "string",
							"minLength": 1
						},
						"operation": {
							"type": "string",
							"minLength": 1
						},
						"event": {
							"type": "string",
							"const": "package.version.changed"
						}
					},
					"required": [
						"id",
						"source",
						"stream",
						"operation",
						"event"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{0,63}$"
						},
						"source": {
							"type": "string",
							"minLength": 1
						},
						"stream": {
							"type": "string",
							"minLength": 1
						},
						"operation": {
							"type": "string",
							"minLength": 1
						},
						"event": {
							"type": "string",
							"const": "workflow_run"
						},
						"workflow": {
							"type": "string",
							"pattern": "^[\\w-]+\\.ya?ml$"
						}
					},
					"required": [
						"id",
						"source",
						"stream",
						"operation",
						"event",
						"workflow"
					],
					"additionalProperties": false
				}
			]
		}
	}
}
