{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://beepboop.kjanat.dev/schema/v1.json",
	"title": "Repository release automation",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"extends": {
			"default": [],
			"type": "array",
			"items": {
				"type": "string",
				"pattern": "^github>([\\w.-]+\\/[\\w.-]+):([\\w-]+)(?:#([\\w./-]+))?$"
			}
		},
		"managers": {
			"default": [
				"pre-commit",
				"cargo",
				"npm",
				"jsr",
				"pypi",
				"github-release",
				"oci",
				"goreleaser",
				"go",
				"vscode",
				"manifest",
				"workflow"
			],
			"type": "array",
			"items": {
				"type": "string",
				"enum": [
					"pre-commit",
					"cargo",
					"npm",
					"jsr",
					"pypi",
					"github-release",
					"oci",
					"goreleaser",
					"go",
					"vscode",
					"manifest",
					"workflow"
				]
			}
		},
		"streams": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{0,63}$"
			},
			"additionalProperties": {
				"$ref": "#/$defs/stream"
			}
		},
		"subscriptions": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/subscription"
			}
		},
		"winget": {
			"type": "object",
			"properties": {
				"config": {
					"type": "string",
					"pattern": "^[\\w./-]+\\.json$",
					"description": "Path to WinGet package JSON in the release commit"
				},
				"tagPrefix": {
					"default": "v",
					"type": "string",
					"pattern": "^[\\w.-]*$"
				},
				"automatic": {
					"default": false,
					"type": "boolean"
				}
			},
			"required": [
				"config"
			],
			"additionalProperties": false
		},
		"actionsRevision": {
			"description": "Published Actions version or full commit that setup pins in generated workflows",
			"type": "string",
			"pattern": "^(?:[a-f0-9]{40}|v\\d+(?:\\.\\d+){0,2})$"
		}
	},
	"additionalProperties": false,
	"$defs": {
		"stream": {
			"type": "object",
			"properties": {
				"versioning": {
					"default": "workspace",
					"type": "string",
					"enum": [
						"workspace",
						"independent",
						"none"
					]
				},
				"versionFiles": {
					"type": "array",
					"items": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "json"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1
												},
												{
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												}
											]
										}
									}
								},
								"required": [
									"path",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "yaml"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1
												},
												{
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												}
											]
										}
									}
								},
								"required": [
									"path",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "toml"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"type": "string",
											"pattern": "^[A-Za-z0-9_-]+$"
										}
									}
								},
								"required": [
									"path",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "text"
									},
									"prefix": {
										"type": "string",
										"minLength": 1
									},
									"suffix": {
										"type": "string",
										"minLength": 1
									}
								},
								"required": [
									"path",
									"format",
									"prefix",
									"suffix"
								],
								"additionalProperties": false
							}
						]
					}
				},
				"versionSource": {
					"type": "object",
					"properties": {
						"kind": {
							"type": "string",
							"const": "tags"
						},
						"prefix": {
							"type": "string",
							"pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]*$"
						}
					},
					"required": [
						"kind",
						"prefix"
					],
					"additionalProperties": false
				},
				"packages": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/packageReference"
					}
				},
				"prepare": {
					"type": "object",
					"properties": {
						"version": {
							"type": "string",
							"const": "manual"
						},
						"workflow": {
							"$ref": "#/$defs/workflow"
						},
						"strategy": {
							"type": "string",
							"enum": [
								"managed",
								"workflow"
							]
						},
						"bump": {
							"$ref": "#/$defs/versionBump"
						}
					},
					"additionalProperties": false
				},
				"promote": {
					"type": "object",
					"properties": {
						"approval": {
							"default": "required",
							"type": "string",
							"enum": [
								"required",
								"merge",
								"push"
							]
						},
						"workflow": {
							"$ref": "#/$defs/workflow"
						}
					},
					"additionalProperties": false
				},
				"start": {
					"$ref": "#/$defs/releaseStarts"
				},
				"workflows": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{0,63}$"
					},
					"additionalProperties": {
						"$ref": "#/$defs/workflow"
					}
				},
				"required": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/packageReference"
					}
				},
				"needs": {
					"description": "Publications that must finish before each listed publication, keyed by package reference",
					"type": "object",
					"propertyNames": {
						"type": "string",
						"minLength": 1
					},
					"additionalProperties": {
						"type": "array",
						"items": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				"credentials": {
					"default": [],
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"channels": {
					"default": {
						"stable": "latest",
						"prerelease": "next"
					},
					"type": "object",
					"properties": {
						"stable": {
							"default": "latest",
							"type": "string",
							"minLength": 1
						},
						"prerelease": {
							"default": "next",
							"type": "string",
							"minLength": 1
						}
					},
					"additionalProperties": false
				},
				"concurrency": {
					"default": "queue",
					"type": "string",
					"enum": [
						"queue",
						"supersede-pending"
					]
				}
			},
			"additionalProperties": false
		},
		"packageReference": {
			"description": "Package URL (versionless for release selection). Legacy manager:name references are accepted for compatibility.",
			"type": "string",
			"minLength": 1
		},
		"workflow": {
			"type": "object",
			"properties": {
				"file": {
					"type": "string",
					"pattern": "^[\\w-][\\w.-]*\\.ya?ml$"
				},
				"ref": {
					"type": "string",
					"pattern": "^(?:refs\\/(?:heads|tags)\\/)?[A-Za-z0-9][A-Za-z0-9._/-]*\\*?$"
				},
				"inputs": {
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": [
							"string",
							"boolean",
							"number"
						]
					}
				},
				"required": {
					"type": "boolean"
				},
				"needs": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				},
				"needsJobs": {
					"description": "Jobs of an observed operation in needs that must succeed before this operation starts, keyed by that operation",
					"type": "object",
					"propertyNames": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{0,63}$"
					},
					"additionalProperties": {
						"minItems": 1,
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
						}
					}
				},
				"schedule": {
					"type": "string",
					"minLength": 1
				},
				"publications": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/packageReference"
					}
				},
				"mode": {
					"type": "string",
					"enum": [
						"observe",
						"dispatch"
					]
				},
				"each": {
					"type": "string",
					"const": "package"
				},
				"refs": {
					"type": "object",
					"properties": {
						"phase": {
							"type": "string",
							"enum": [
								"version",
								"aliases"
							]
						},
						"prefix": {
							"default": "v",
							"type": "string",
							"pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]*$"
						},
						"aliases": {
							"default": [],
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"major",
									"minor"
								]
							}
						},
						"signed": {
							"type": "boolean"
						}
					},
					"required": [
						"phase"
					],
					"additionalProperties": false
				},
				"platform": {
					"type": "object",
					"properties": {
						"os": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						},
						"arch": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						},
						"abi": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						}
					},
					"required": [
						"os",
						"arch"
					],
					"additionalProperties": false
				},
				"outputs": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"kind": {
								"type": "string",
								"enum": [
									"archive",
									"binary",
									"manifest",
									"package",
									"checksums"
								]
							}
						},
						"required": [
							"id",
							"kind"
						],
						"additionalProperties": false
					}
				},
				"artifactInputs": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"operation": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"output": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							}
						},
						"required": [
							"operation",
							"output"
						],
						"additionalProperties": false
					}
				},
				"setup": {
					"$ref": "#/$defs/workflowSetup"
				}
			},
			"required": [
				"file"
			],
			"additionalProperties": false
		},
		"workflowSetup": {
			"type": "object",
			"properties": {
				"job": {
					"type": "string"
				},
				"triggers": {
					"default": "review",
					"type": "string",
					"enum": [
						"review",
						"dispatchOnly",
						"preserve"
					]
				},
				"commands": {
					"default": "",
					"type": "string"
				},
				"publicationSteps": {
					"default": {},
					"type": "object",
					"propertyNames": {
						"type": "string"
					},
					"additionalProperties": {
						"type": "string"
					}
				},
				"credentials": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"pattern": "^[A-Z_][A-Z0-9_]*$"
					},
					"additionalProperties": {
						"type": "string",
						"pattern": "^[\\w-]{1,64}$"
					}
				},
				"tagPrefix": {
					"type": "string",
					"pattern": "^(?:[A-Za-z0-9._-]+\\/)*[A-Za-z0-9._-]*$"
				},
				"binaries": {
					"type": "object",
					"properties": {
						"builds": {
							"minItems": 1,
							"type": "array",
							"items": {
								"oneOf": [
									{
										"type": "object",
										"properties": {
											"toolchain": {
												"type": "string",
												"const": "go"
											},
											"name": {
												"type": "string",
												"pattern": "^[A-Za-z0-9][\\w.-]*$"
											},
											"module": {
												"type": "string",
												"pattern": "^(?:\\.|[\\w.-]+(?:\\/[\\w.-]+)*)$"
											},
											"package": {
												"default": ".",
												"type": "string",
												"pattern": "^\\.(?:\\/[\\w.-]+)*$"
											},
											"asset": {
												"default": "{name}-{go.os}-{go.arch}{ext}",
												"type": "string",
												"pattern": "^(?:[\\w.-]|\\{[\\w.]+\\})+$"
											}
										},
										"required": [
											"toolchain",
											"name",
											"module"
										],
										"additionalProperties": false
									},
									{
										"type": "object",
										"properties": {
											"toolchain": {
												"type": "string",
												"const": "cargo"
											},
											"name": {
												"type": "string",
												"pattern": "^[A-Za-z0-9][\\w.-]*$"
											},
											"manifest": {
												"type": "string",
												"pattern": "^(?:[\\w.-]+\\/)*Cargo\\.toml$"
											},
											"asset": {
												"default": "{name}-{rust.target}{ext}",
												"type": "string",
												"pattern": "^(?:[\\w.-]|\\{[\\w.]+\\})+$"
											}
										},
										"required": [
											"toolchain",
											"name",
											"manifest"
										],
										"additionalProperties": false
									}
								]
							}
						},
						"targets": {
							"default": [
								"linux-amd64",
								"linux-arm64",
								"darwin-amd64",
								"darwin-arm64",
								"windows-amd64",
								"windows-arm64"
							],
							"minItems": 1,
							"type": "array",
							"items": {
								"type": "string",
								"enum": [
									"linux-amd64",
									"linux-arm64",
									"darwin-amd64",
									"darwin-arm64",
									"windows-amd64",
									"windows-arm64"
								]
							}
						}
					},
					"required": [
						"builds"
					],
					"additionalProperties": false
				}
			},
			"additionalProperties": false,
			"description": "Setup input that generates this workflow file. Change it through a setup update PR."
		},
		"versionBump": {
			"type": "string",
			"enum": [
				"commit",
				"pr"
			],
			"description": "How Beepboop applies a version bump: commit pushes a signed bot commit to the default branch, pr opens a version PR."
		},
		"releaseStarts": {
			"type": "array",
			"items": {
				"oneOf": [
					{
						"type": "object",
						"properties": {
							"via": {
								"type": "string",
								"const": "action"
							},
							"workflow": {
								"type": "string",
								"pattern": "^[\\w-][\\w.-]*\\.ya?ml$"
							}
						},
						"required": [
							"via",
							"workflow"
						],
						"additionalProperties": false
					},
					{
						"type": "object",
						"properties": {
							"via": {
								"type": "string",
								"const": "dashboard"
							}
						},
						"required": [
							"via"
						],
						"additionalProperties": false
					},
					{
						"type": "object",
						"properties": {
							"via": {
								"type": "string",
								"const": "cli"
							}
						},
						"required": [
							"via"
						],
						"additionalProperties": false
					}
				]
			},
			"description": "Where a release of this stream can start. A start approves the whole release: the version bump, publication, binaries, tags and the GitHub release run without another approval."
		},
		"subscription": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{0,63}$"
						},
						"source": {
							"type": "string",
							"minLength": 1
						},
						"stream": {
							"type": "string",
							"minLength": 1
						},
						"operation": {
							"type": "string",
							"minLength": 1
						},
						"event": {
							"type": "string",
							"const": "release"
						},
						"sourceStream": {
							"type": "string",
							"minLength": 1
						},
						"sourceGroup": {
							"type": "string",
							"minLength": 1
						},
						"publication": {
							"type": "string",
							"minLength": 1
						}
					},
					"required": [
						"id",
						"source",
						"stream",
						"operation",
						"event"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{0,63}$"
						},
						"source": {
							"type": "string",
							"minLength": 1
						},
						"stream": {
							"type": "string",
							"minLength": 1
						},
						"operation": {
							"type": "string",
							"minLength": 1
						},
						"event": {
							"type": "string",
							"const": "package.version.changed"
						}
					},
					"required": [
						"id",
						"source",
						"stream",
						"operation",
						"event"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"id": {
							"type": "string",
							"pattern": "^[a-z][a-z0-9-]{0,63}$"
						},
						"source": {
							"type": "string",
							"minLength": 1
						},
						"stream": {
							"type": "string",
							"minLength": 1
						},
						"operation": {
							"type": "string",
