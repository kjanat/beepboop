{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://beepboop.kjanat.dev/schema/v1.json",
	"title": "Repository release automation",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"type": "string"
		},
		"extends": {
			"type": "array",
			"items": {
				"type": "string"
			}
		},
		"managers": {
			"type": "array",
			"items": {
				"enum": [
					"cargo",
					"npm",
					"github-release",
					"oci",
					"goreleaser",
					"manifest",
					"workflow",
					"pre-commit"
				]
			}
		},
		"streams": {
			"type": "object",
			"propertyNames": {
				"pattern": "^[a-z][a-z0-9-]{0,63}$"
			},
			"additionalProperties": {
				"$ref": "#/$defs/stream"
			}
		},
		"subscriptions": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"properties": {
					"id": {
						"type": "string"
					},
					"source": {
						"type": "string"
					},
					"event": {
						"enum": [
							"release",
							"workflow_run",
							"package.version.changed"
						]
					},
					"stream": {
						"type": "string"
					},
					"operation": {
						"type": "string"
					},
					"workflow": {
						"type": "string"
					},
					"sourceStream": {
						"type": "string",
						"minLength": 1
					},
					"sourceGroup": {
						"type": "string",
						"minLength": 1
					},
					"publication": {
						"type": "string",
						"minLength": 1
					}
				},
				"required": [
					"id",
					"source",
					"event",
					"stream",
					"operation"
				]
			}
		}
	},
	"$defs": {
		"workflow": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"file": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_-]+\\.ya?ml$"
				},
				"ref": {
					"type": "string"
				},
				"inputs": {
					"type": "object",
					"additionalProperties": {
						"type": [
							"string",
							"boolean",
							"number"
						]
					}
				},
				"required": {
					"type": "boolean"
				},
				"needs": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"publications": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"schedule": {
					"type": "string"
				},
				"mode": {
					"enum": [
						"observe",
						"dispatch"
					]
				},
				"refs": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"phase"
					],
					"properties": {
						"phase": {
							"enum": [
								"version",
								"aliases"
							]
						},
						"prefix": {
							"type": "string",
							"pattern": "^[A-Za-z0-9._-]*$"
						},
						"aliases": {
							"type": "array",
							"uniqueItems": true,
							"items": {
								"enum": [
									"major",
									"minor"
								]
							}
						},
						"signed": {
							"type": "boolean"
						}
					}
				},
				"platform": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"os",
						"arch"
					],
					"properties": {
						"os": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						},
						"arch": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						},
						"abi": {
							"type": "string",
							"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
						}
					}
				},
				"outputs": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"id",
							"kind"
						],
						"properties": {
							"id": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"kind": {
								"enum": [
									"archive",
									"binary",
									"manifest",
									"package",
									"checksums"
								]
							}
						}
					}
				},
				"artifactInputs": {
					"type": "array",
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"operation",
							"output"
						],
						"properties": {
							"operation": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							},
							"output": {
								"type": "string",
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
							}
						}
					}
				}
			},
			"required": [
				"file"
			]
		},
		"stream": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"versioning": {
					"enum": [
						"workspace",
						"independent",
						"none"
					]
				},
				"prepare": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"version": {
							"const": "manual"
						},
						"workflow": {
							"$ref": "#/$defs/workflow"
						},
						"strategy": {
							"enum": [
								"managed",
								"workflow"
							]
						}
					}
				},
				"promote": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"approval": {
							"const": "required"
						},
						"workflow": {
							"$ref": "#/$defs/workflow"
						}
					}
				},
				"workflows": {
					"type": "object",
					"propertyNames": {
						"pattern": "^[a-z][a-z0-9-]{0,63}$"
					},
					"additionalProperties": {
						"$ref": "#/$defs/workflow"
					}
				},
				"required": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"credentials": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"channels": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"stable": {
							"type": "string"
						},
						"prerelease": {
							"type": "string"
						}
					}
				},
				"concurrency": {
					"enum": [
						"queue",
						"supersede-pending"
					]
				},
				"packages": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"versionSource": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"prefix"
					],
					"properties": {
						"kind": {
							"const": "tags"
						},
						"prefix": {
							"type": "string",
							"pattern": "^[A-Za-z0-9._-]*$"
						}
					}
				},
				"versionFiles": {
					"type": "array",
					"items": {
						"oneOf": [
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "json"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1
												},
												{
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												}
											]
										}
									}
								},
								"required": [
									"path",
									"template",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "yaml"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"anyOf": [
												{
													"type": "string",
													"minLength": 1
												},
												{
													"type": "integer",
													"minimum": 0,
													"maximum": 9007199254740991
												}
											]
										}
									}
								},
								"required": [
									"path",
									"template",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "toml"
									},
									"key": {
										"minItems": 1,
										"type": "array",
										"items": {
											"type": "string",
											"pattern": "^[A-Za-z0-9_-]+$"
										}
									}
								},
								"required": [
									"path",
									"template",
									"format",
									"key"
								],
								"additionalProperties": false
							},
							{
								"type": "object",
								"properties": {
									"path": {
										"type": "string"
									},
									"group": {
										"type": "string",
										"minLength": 1
									},
									"template": {
										"default": "{version}",
										"type": "string",
										"maxLength": 1000
									},
									"format": {
										"type": "string",
										"const": "text"
									},
									"prefix": {
										"type": "string",
										"minLength": 1
									},
									"suffix": {
										"type": "string",
										"minLength": 1
									}
								},
								"required": [
									"path",
									"template",
									"format",
									"prefix",
									"suffix"
								],
								"additionalProperties": false
							}
						]
					}
				}
			}
		}
	}
}
