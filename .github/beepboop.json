{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "streams": {
    "cli": {
      "packages": ["pkg:npm/%40kjanat/beepboop", "pkg:jsr/%40kjanat/beepboop"],
      "versioning": "workspace",
      "credentials": ["npm-token"],
      "required": ["pkg:npm/%40kjanat/beepboop", "pkg:jsr/%40kjanat/beepboop"],
      "prepare": {
        "strategy": "managed",
        "workflow": {
          "file": "prepare-cli.yml",
          "ref": "master",
          "setup": {
            "job": "prepare"
          }
        }
      },
      "promote": {
        "approval": "merge",
        "workflow": {
          "file": "publish-cli.yml",
          "ref": "master",
          "publications": [
            "pkg:npm/%40kjanat/beepboop",
            "pkg:jsr/%40kjanat/beepboop"
          ],
          "setup": {
            "job": "publish"
          }
        }
      }
    }
  },
  "managers": ["jsr", "npm", "workflow"]
}
