{
	"$schema": "./node_modules/@effect/tsgo/schema.json",
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"@root/*": ["./*"],
			"@/kernel/*": ["./packages/kernel/src/*"],
			"@/host/*": ["./packages/host/src/*"],
			"@/package-url": ["./packages/domain/src/purl/index.ts"],
			"@/package-url/*": ["./packages/domain/src/purl/*"],
			"@/persistence/*": ["./packages/persistence/src/*"],
			"@/cli/*": ["./packages/cli/src/*"],
			"@/domain/*": ["./packages/domain/src/*"],
			"@/github/*": ["./packages/github/src/*"],
			"@/credentials/*": ["./packages/credentials/src/*"],
			"@/auth/*": ["./packages/auth/src/*"],
			"@/discovery/*": ["./packages/discovery/src/*"],
			"@/notifications/*": ["./packages/notifications/src/*"],
			"@/publication/*": ["./packages/publication/src/*"]
		},
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowJs": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": ["bun", "./worker-configuration.d.ts"],
		"plugins": [
			{
				"name": "@effect/language-service"
			}
		],
	},
	"contentMappers": [
		{ "package": "@astrojs/ts-content-mapper", "extensions": [".astro"] }
	],
	"exclude": ["src/ui/browser/**"],
	"include": [
		".astro/types.d.ts",
		"src/**/*.astro",
		"src/**/*.ts",
		"scripts/**/*.ts",
		"actions/**/*.ts",
		"packages/*/src/**/*.ts",
		"test/**/*.ts"
	]
}
