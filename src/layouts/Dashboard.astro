---
import icon from '@root/assets/beepboop-icon.png';
import Arrow from '@/components/Arrow.astro';
import Field from '@/components/Field.astro';
import type { GitHubOutage } from '@/server/github-status.ts';
import { type Section, sectionPages, sections } from '@/server/sections.ts';
import '@/styles/dashboard.css';

interface Props {
	section: Section;
	outage: GitHubOutage | undefined;
}
const { section, outage } = Astro.props;
const { title, description } = sectionPages[section];
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title} | Beepboop</title>
		<link rel="icon" href="/favicon.ico?v=beepboop" sizes="16x16 32x32 48x48">
		<link
			rel="icon"
			type="image/png"
			href="/favicon-32.png?v=beepboop"
			sizes="32x32"
		>
		<link
			rel="icon"
			type="image/png"
			href="/icon-192.png?v=beepboop"
			sizes="192x192"
		>
		<link
			rel="apple-touch-icon"
			href="/apple-touch-icon.png?v=beepboop"
			sizes="180x180"
		>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<aside class="sidebar">
			<a class="brand" href="/"><img
					class="robot"
					src={icon.src}
					width="36"
					height="36"
					alt=""
				> Beepboop</a>
			<p class="sidebar-caption">From commit to published.</p>
			<nav aria-label="Main navigation">
				{sections.map(key => (
					<a
						href={sectionPages[key].path}
						aria-current={key === section ? 'page' : undefined}
					>{sectionPages[key].nav}</a>
				))}
			</nav>
			<div class="sidebar-bottom">
				<p>Repository-owned releases.</p>
				<p>One place to follow them.</p>
				<form action="/auth/logout" method="post">
					<button class="quiet">Sign out</button>
				</form>
			</div>
		</aside>
		<main id="main">
			{outage && (
				<section class="outage" aria-label="GitHub status">
					<p>
						<strong>GitHub: {outage.description}.</strong> Beepboop's runs,
						pushes and pull requests may fail or stall until GitHub recovers.
					</p>
					{outage.incidents.length > 0 && (
						<ul>
							{outage.incidents.map(incident => (
								<li>
									{incident.name}
									<Arrow
										href={incident.url}
										label={`Open incident ${incident.name}`}
									/>
									({incident.status})
								</li>
							))}
						</ul>
					)}
					{outage.components.length > 0 && (
						<dl class="fields">
							<Field label="Affected">
								<ul class="inline-list">
									{outage.components.map(component => (
										<li>{component.name} ({component.status})</li>
									))}
								</ul>
							</Field>
						</dl>
					)}
					<p class="outage-links">
						<span>Live status <Arrow
								href={outage.page}
								label="Open live GitHub status"
							/></span>
						<span>githubstatus.com <Arrow
								href={outage.source}
								label="Open githubstatus.com"
							/></span>
					</p>
				</section>
			)}
			<header class="page-header">
				<div>
					<p class="eyebrow">Release automation</p>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
				</div>
				<a class="quiet button" href={Astro.url.pathname}>Refresh</a>
			</header>
			<output
				id="feedback"
				role="status"
				aria-live="polite"
				tabindex="-1"
				hidden
			></output>
			<slot />
		</main>
		<script src="@/ui/browser/app.ts"></script>
	</body>
</html>
