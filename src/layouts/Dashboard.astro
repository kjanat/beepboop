---
import icon from '@root/assets/beepboop-icon.png';
import Field from '@/components/Field.astro';
import { githubOutage } from '@/server/github-status.ts';
import '@/styles/dashboard.css';

interface Props {
	title: string;
	description: string;
	section: string;
}
const { title, description, section } = Astro.props;
const outage = await githubOutage();
const navigation = [
	['overview', '/', 'Overview'],
	['repositories', '/repositories', 'Repositories'],
	['packages', '/packages', 'Packages'],
	['notifications', '/notifications', 'Notifications'],
	['releases', '/releases', 'Prepare a release'],
	['runs', '/runs', 'Release runs'],
	['secrets', '/secrets', 'Secrets'],
	['activity', '/activity', 'Activity'],
	['security', '/security', 'Security keys'],
];
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title} | Beepboop</title>
		<link rel="icon" href="/favicon.ico?v=beepboop" sizes="16x16 32x32 48x48">
		<link
			rel="icon"
			type="image/png"
			href="/favicon-32.png?v=beepboop"
			sizes="32x32"
		>
		<link
			rel="icon"
			type="image/png"
			href="/icon-192.png?v=beepboop"
			sizes="192x192"
		>
		<link
			rel="apple-touch-icon"
			href="/apple-touch-icon.png?v=beepboop"
			sizes="180x180"
		>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<aside class="sidebar">
			<a class="brand" href="/"><img
					class="robot"
					src={icon.src}
					width="36"
					height="36"
					alt=""
				> Beepboop</a>
			<p class="sidebar-caption">From commit to published.</p>
			<nav aria-label="Main navigation">
				{navigation.map(([key, href, label]) => (
					<a
						href={href}
						aria-current={key === section ? 'page' : undefined}
					>{label}</a>
				))}
			</nav>
			<div class="sidebar-bottom">
				<p>Repository-owned releases.<br>One place to follow them.</p>
				<form action="/auth/logout" method="post">
					<button class="quiet">Sign out</button>
				</form>
			</div>
		</aside>
		<main id="main">
			{outage && (
				<section class="outage" role="alert">
					<p>
						<strong>GitHub: {outage.description}.</strong> Beepboop's runs,
						pushes and pull requests may fail or stall until GitHub recovers.
					</p>
					{outage.incidents.length > 0 && (
						<ul>
							{outage.incidents.map(incident => (
								<li>
									<a href={incident.url}>{incident.name}</a> ({incident.status})
								</li>
							))}
						</ul>
					)}
					{outage.components.length > 0 && (
						<p>
							<Field
								label="Affected"
							>{outage.components.map(component => `${component.name} (${component.status})`)
								.join(', ')}</Field>
						</p>
					)}
					<p>
						<a href={outage.page}>Live status</a> <small><a href={outage.source}
							>githubstatus.com</a></small>
					</p>
				</section>
			)}
			<header class="page-header">
				<div>
					<p class="eyebrow">Release automation</p>
					<h1>{title}</h1>
					<p class="lede">{description}</p>
				</div><a class="quiet button" href={Astro.url.pathname}>Refresh</a>
			</header>
			<output
				id="feedback"
				role="status"
				aria-live="polite"
				tabindex="-1"
				hidden
			></output>
			<slot />
		</main>
		<script src="@/ui/browser/app.ts"></script>
	</body>
</html>
