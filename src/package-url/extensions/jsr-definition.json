{
	"$schema": "https://packageurl.org/purl-schemas/purl-type-definition.schema-1.1.json",
	"$id": "https://packageurl.org/purl-types/jsr-definition.json",
	"type": "jsr",
	"type_name": "JSR",
	"description": "JSR packages. Provisional extension for package-url/purl-spec#457; not an upstream registered definition.",
	"repository": {
		"use_repository": true,
		"default_repository_url": "https://jsr.io/"
	},
	"namespace_definition": {
		"requirement": "required",
		"case_sensitive": true,
		"native_name": "scope",
		"permitted_characters": "^@[a-z0-9][a-z0-9-]{1,19}$",
		"note": "All JSR packages are scoped. Include @ in the namespace and percent-encode it in the PURL."
	},
	"name_definition": {
		"requirement": "required",
		"case_sensitive": true,
		"native_name": "name",
		"permitted_characters": "^[a-z0-9][a-z0-9-]{1,57}$"
	},
	"version_definition": {
		"requirement": "optional",
		"case_sensitive": true,
		"native_name": "version",
		"permitted_characters": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$"
	},
	"examples": [
		"pkg:jsr/%40kjanat/beepboop",
		"pkg:jsr/%40std/path@1.0.0"
	],
	"reference_urls": [
		"https://github.com/package-url/purl-spec/issues/457",
		"https://jsr.io/docs/scopes",
		"https://jsr.io/docs/packages"
	]
}
