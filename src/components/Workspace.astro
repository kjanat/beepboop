---
import { Effect } from 'effect';
import Activity from '@/components/Activity.astro';
import Notifications from '@/components/Notifications.astro';
import Overview from '@/components/Overview.astro';
import Packages from '@/components/Packages.astro';
import Releases from '@/components/Releases.astro';
import Repositories from '@/components/Repositories.astro';
import Runs from '@/components/Runs.astro';
import Secrets from '@/components/Secrets.astro';
import Security from '@/components/Security.astro';
import WinGet from '@/components/WinGet.astro';
import Layout from '@/layouts/Dashboard.astro';
import { bindings } from '@/server/bindings.ts';
import { githubOutage } from '@/server/github-status.ts';
import { load, panel } from '@/server/loaders.ts';
import type { Section } from '@/server/sections.ts';

interface Props {
	section: Section;
}
const { section } = Astro.props;
const { actor } = Astro.locals;
if (!actor) {
	throw new Error('Dashboard pages require a signed-in administrator');
}
const [view, outage] = await Effect.runPromise(Effect.all([
	load(section, { env: bindings(), actor }),
	panel('github-status', githubOutage),
], { concurrency: 'unbounded' }));
---
<Layout
	section={section}
	outage={outage.kind === 'loaded' ? outage.value : undefined}
>
	{view.section === 'overview' && <Overview data={view} />}
	{view.section === 'repositories' && <Repositories data={view} />}
	{view.section === 'packages' && <Packages data={view} />}
	{view.section === 'notifications' && <Notifications data={view} />}
	{view.section === 'releases' && <Releases data={view} />}
	{view.section === 'runs' && <Runs data={view} />}
	{view.section === 'winget' && <WinGet data={view} />}
	{view.section === 'secrets' && <Secrets data={view} />}
	{view.section === 'security' && <Security data={view} />}
	{view.section === 'activity' && <Activity data={view} />}
</Layout>
