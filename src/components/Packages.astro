---
import Arrow from '@/components/Arrow.astro';
import Badge from '@/components/Badge.astro';
import Time from '@/components/Time.astro';
import { destinationLabels, watchedRegistries } from '@/contract/catalog';
import { watchedPackageHref } from '@/contract/links';
import type { ViewOf } from '@/server/loaders.ts';
import { packagesPage } from '@/server/views/packages.ts';

interface Props {
	data: ViewOf<'packages'>;
}
const { data } = Astro.props;
const packages = packagesPage(data);
---
<article>
	<h2>Watch a package</h2>
	<p>
		Beepboop already watches every npm and JSR package your repositories publish
		or subscribe to. Add other packages here.
	</p>
	<form
		data-action="package-add"
		method="post"
		action="/api/packages/add"
		class="form-row"
	>
		<label>
			Registry
			<select name="registry">
				{watchedRegistries.map(registry => (
					<option value={registry}>{destinationLabels[registry]}</option>
				))}
			</select>
		</label>
		<label>
			Package name
			<input
				name="name"
				placeholder="@scope/package"
				maxlength="214"
				required
			>
		</label>
		<button class="primary">Watch package</button>
	</form>
</article>
{!data.packages.length && (
	<article class="empty">
		<h2>No packages watched</h2>
		<p>
			Inspect a repository that publishes to npm or JSR, or add a package above.
		</p>
	</article>
)}
{data.packages.length > 0 && (
	<div class="table-scroll">
		<table>
			<thead>
				<tr>
					<th>Package</th>
					<th>Version</th>
					<th>Last check</th>
					<th>Published by</th>
					<th>Dependency of</th>
					<th>Notifications</th>
					<th><span class="visually-hidden">Actions</span></th>
				</tr>
			</thead>
			<tbody>
				{packages.map(pkg => (
					<tr>
						<td>
							<Badge tone="neutral" label={destinationLabels[pkg.registry]} />
							{pkg.name}
							<Arrow
								href={watchedPackageHref(pkg.registry, pkg.name)}
								label={`Open ${pkg.name} on ${destinationLabels[pkg.registry]}`}
							/>
						</td>
						<td>{pkg.version ?? 'Not checked yet'}</td>
						<td>
							{pkg.checkedAt ? (
								<Time value={pkg.checkedAt} />
							) : 'Never'}{pkg.error && (
								<Badge tone="error" label={pkg.error} />
							)}
						</td>
						<td>
							{pkg.publishers.length ? (
								<ul class="package-list">
									{pkg.publishers.map(name => (
										<li>
											{name}
											<Arrow
												href={`/repositories?repository=${encodeURIComponent(name)}`}
												label={`Show repository ${name}`}
											/>
										</li>
									))}
								</ul>
							) : '—'}
						</td>
						<td>
							{pkg.dependents.length ? (
								<ul class="package-list">
									{pkg.dependents.map(name => (
										<li>
											{name}
											<Arrow
												href={`/repositories?repository=${encodeURIComponent(name)}`}
												label={`Show repository ${name}`}
											/>
										</li>
									))}
								</ul>
							) : '—'}
						</td>
						<td>
							{pkg.notifications.length ? (
								<div class="toggles">
									{pkg.notifications.map(({ destination, subscribed }) => (
										<form
											data-action="package-subscription"
											method="post"
											action="/api/packages/subscription"
										>
											<input
												type="hidden"
												name="destinationId"
												value={destination.id}
											>
											<input type="hidden" name="registry" value={pkg.registry}>
											<input type="hidden" name="name" value={pkg.name}>
											<input
												type="hidden"
												name="subscribed"
												value={String(!subscribed)}
											>
											<button
												class="toggle"
												aria-pressed={subscribed}
												aria-label={`${destination.name} notifications for ${pkg.name}`}
											>
												{destination.name}
											</button>
										</form>
									))}
								</div>
							) : <a href="/notifications">Add a destination</a>}
						</td>
						<td>
							{pkg.manual && (
								<form
									data-action="package-remove"
									method="post"
									action="/api/packages/remove"
								>
									<input type="hidden" name="registry" value={pkg.registry}>
									<input type="hidden" name="name" value={pkg.name}>
									<button
										class="quiet"
										aria-label={`Stop watching ${pkg.name}`}
									>
										Stop watching
									</button>
								</form>
							)}
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
)}
<p class="hint">
	Beepboop checks every package every ten minutes. A new version starts
	subscribed repository operations and notifies the destinations switched on in
	its row.
</p>
