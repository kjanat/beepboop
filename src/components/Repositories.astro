---
import { wingetOutcome } from '@/automation/destinations';
import { exclusionLabel, publishable } from '@/automation/package-publication';
import { publishedOutsideRequired } from '@/automation/setup';
import type { RepositoryRecord } from '@/automation/types';
import type { Dashboard } from '@/server/dashboard.ts';
import { date, workflowChoices } from '@/server/dashboard.ts';
import { packageUrl } from '@/server/package-url';
import {
	manifestEntry,
	packageDestinations,
	repositoryChannels,
} from '@/ui/destinations';
import { packageLabel } from '@/ui/package-label';

interface Props {
	data: Dashboard;
}
const { data } = Astro.props;
const selected = Astro.url.searchParams.get('repository');
const repositories = [...data.repositories].sort((left, right) =>
	Number(right.name === selected) - Number(left.name === selected)
);
function listsPackages(repository: RepositoryRecord) {
	return repository.inventory.packages.some(publishable)
		|| Boolean(repository.configuration?.winget)
		|| Boolean(repository.inventory.channels?.length);
}
function wingetDestination(repository: RepositoryRecord) {
	const policy = repository.configuration?.winget;
	if (!policy) return undefined;
	const submission = data.latestWinget.get(repository.id);
	return {
		policy,
		packageIdentifier: submission?.plan.packageIdentifier,
		entry: manifestEntry(wingetOutcome(submission)),
	};
}
---
<article>
	<h2>Connect a repository</h2>
	<p>
		First install the Beepboop GitHub App on the repository. Inspection reads
		its packages and workflows; the setup pull request lets you review its
		release configuration.
	</p>
	<form data-action="discover" class="form-row">
		<label>GitHub repository<input
				name="repository"
				placeholder="name, owner/name or GitHub URL"
				required
			></label><button class="primary">Inspect repository</button>
	</form>
</article>
{repositories.map(repository => (
	<article id={`repository-${repository.id}`}>
		<details open={repository.name === selected || repositories.length === 1}>
			<summary class="section-heading">
				<div>
					<h2>
						<a href={`https://github.com/${repository.name}`}>{repository.name}
							↗</a>
					</h2>
					<p class="metadata metadata-fields">
						<span>Inspected {date(repository.updatedAt)}</span><span>Commit <a
								href={`https://github.com/${repository.name}/commit/${repository.sha}`}
							><code>{repository.sha.slice(0, 12)}</code></a></span>
					</p>
				</div><span
					class:list={[
						'badge',
						repository.suspended || repository.diagnostics.length
							? 'blocked'
							: 'succeeded',
					]}
				>{repository.suspended
					? 'App access unavailable'
					: repository.configuration && !repository.diagnostics.length
					? 'Configured'
					: 'Setup needed'}</span>
			</summary>
			{repository.diagnostics.map(message => <p class="notice">{message}</p>)}
			{publishedOutsideRequired(repository).map(gap => (
				<p class="notice">
					Published but not required in <strong>{gap.stream}</strong>:{' '}
					{gap.packages.map(packageLabel).join(', ')}. Edit release setup
					proposes adding them.
				</p>
			))}
			<div class="actions">
				<form data-action="discover">
					<input
						type="hidden"
						name="repository"
						value={repository.name}
					><button>
						Refresh inspection
					</button>
				</form>
				{data.onboarding.get(repository.id) && (
					<a class="button" href={data.onboarding.get(repository.id)}
					>Review setup PR ↗</a>
				)}
				{repository.configuration && !repository.suspended
					&& !repository.diagnostics.length && (
					 <a
						 class="button primary"
						 href={`/releases?repository=${repository.id}`}
					 >Prepare a release</a>
				 )}
			</div>
			<form
				data-action="setup"
				data-repository={repository.name}
				class="release-setup"
			>
				<button class="primary">
					{repository.configuration
						? 'Edit release setup'
						: data.onboarding.get(repository.id)
						? 'Refresh setup proposal'
						: 'Configure releases'}
				</button>
			</form>
			<div class="repository-grid">
				<div>
					<h3>
						Release packages
					</h3>{listsPackages(repository) ? (
						<>
							<table>
								<thead>
									<tr>
										<th>Package</th>
										<th>Destinations</th>
										<th>In repository</th>
									</tr>
								</thead>
								<tbody>
									{repository.inventory.packages.filter(publishable).map(p => (
										<tr>
											<td>
												<code>{packageUrl(p)}</code><small><a
														href={`https://github.com/${repository.name}/blob/${repository.sha}/${
															p.manifest.split('/').map(encodeURIComponent).join('/')
														}`}
													>{p.manifest}</a></small>{p.previousModule && (
													<small>Earlier module: {p.previousModule.name} —
														{p.previousModule.version}</small>
												)}
											</td>
											<td>
												{packageDestinations(p, repository.name).map(entry => (
													<div>
														{entry.href ? (
															<a href={entry.href}>{entry.label}</a>
														) : entry.label}: {entry.status}
													</div>
												))}
											</td>
											<td>
												{p.version
													?? (p.versionSource.startsWith('tags:')
														? 'No matching release tag'
														: 'No version found')}
											</td>
										</tr>
									))}
									{[wingetDestination(repository)].map(winget => winget && (
										<tr>
											<td>
												<code
												>{winget.packageIdentifier ?? 'WinGet manifest'}</code><small
												><a
														href={`https://github.com/${repository.name}/blob/${repository.sha}/${
															winget.policy.config.split('/').map(encodeURIComponent).join('/')
														}`}
													>{winget.policy.config}</a></small>
											</td>
											<td>
												<div>
													{winget.entry.href ? (
														<a href={winget.entry.href}>{winget.entry.label}</a>
													) : winget.entry.label}: {winget.entry.status}
												</div>
											</td>
											<td>
												Release tags starting with <code
												>{winget.policy.tagPrefix}</code>
											</td>
										</tr>
									))}
									{repositoryChannels(repository.inventory).map((
										{ outcome, entry },
									) => (
										<tr>
											<td>
												<code>{outcome.name}</code><small><a
														href={`https://github.com/${repository.name}/blob/${repository.sha}/${
															outcome.manifest.split('/').map(encodeURIComponent).join('/')
														}`}
													>{outcome.manifest}</a></small>
											</td>
											<td>
												<div>
													<a href={entry.href}>{entry.label}</a>: {entry.status}
												</div>
											</td>
											<td>
												{outcome.state === 'tracking' ? 'Default branch' : 'Not linked to a package'}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</>
					) : (
						 <p>No publishable packages discovered.</p>
					 )}{repository.inventory.packages.some(p => !publishable(p)) && (
						<p class="metadata">
							Excluded:{repository.inventory.packages.filter(p => !publishable(p)).map((
								p,
								index,
							) => (
								<span>{index ? ', ' : ' '}<a
										href={`https://github.com/${repository.name}/blob/${repository.sha}/${
											p.manifest.split('/').map(encodeURIComponent).join('/')
										}`}
									>{p.name}</a> ({exclusionLabel(p.publication)})</span>
							))}
						</p>
					)}
				</div>
				<div>
					<h3>Release workflows</h3>{workflowChoices(repository).map(w => (
						<p>
							<strong>{w.stream} / {w.operation}</strong><small><a
									href={`https://github.com/${repository.name}/blob/${repository.sha}/.github/workflows/${w.file}`}
								>{w.file}</a></small><small>Ref: <code
								>{w.ref}</code></small><small>
								{w.mode === 'observe' ? 'Tracks existing triggers' : 'Can be dispatched'}</small>
						</p>
					))}{!workflowChoices(repository).length && (
						<>
							{repository.configuration && (
								<p class="notice">No release workflows configured.</p>
							)}
							{repository.inventory.workflows.map(workflow => (
								<p>
									<strong><a
											href={`https://github.com/${repository.name}/blob/${repository.sha}/.github/workflows/${workflow.file}`}
										>{workflow.name || workflow.file}</a></strong><small
									>{workflow.events.join(', ') || 'No supported triggers'}</small>
								</p>
							))}
							{!repository.inventory.workflows.length && (
								<p>No workflows discovered.</p>
							)}
						</>
					)}
				</div>
			</div>
			{repository.configuration && (
				<details>
					<summary>
						Publications and automation
					</summary>{Object.entries(repository.configuration.streams).map((
						[name, stream],
					) => (
						<p>
							<strong>{name}</strong>:
							{stream.required.join(', ') || 'No publications configured'}
						</p>
					))}{repository.configuration.subscriptions.map(s => (
						<p>
							When {s.source} emits {s.event}, start {s.stream} / {s.operation}.
						</p>
					))}
				</details>
			)}
			{repository.inventory.diagnostics.map(message => (
				<p class="notice">{message}</p>
			))}
		</details>
	</article>
))}
