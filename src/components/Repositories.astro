---
import { winget, wingetOutcome } from '@/automation/destinations';
import { exclusionLabel, publishable } from '@/automation/package-publication';
import { publishedOutsideRequired } from '@/automation/setup';
import type { RepositoryRecord } from '@/automation/types';
import Badge from '@/components/Badge.astro';
import Field from '@/components/Field.astro';
import Time from '@/components/Time.astro';
import { packageLabel } from '@/domain/package-label';
import { readiness } from '@/domain/repository';
import type { ViewOf } from '@/server/loaders.ts';
import { packageDisplayName } from '@/server/package-name';
import { repositoryStatus } from '@/server/views/tone.ts';
import { workflowChoices } from '@/server/views/workflows.ts';
import {
	manifestEntry,
	packageDestinations,
	repositoryChannels,
} from '@/ui/destinations';

interface Props {
	data: ViewOf<'repositories'>;
}
const { data } = Astro.props;
const selected = Astro.url.searchParams.get('repository');
const repositories = [...data.repositories.readable].sort((left, right) =>
	Number(right.name === selected) - Number(left.name === selected)
);
function listsPackages(repository: RepositoryRecord) {
	return repository.inventory.packages.some(publishable)
		|| Boolean(repository.configuration?.winget)
		|| Boolean(repository.inventory.channels?.length);
}
function wingetDestination(repository: RepositoryRecord) {
	const policy = repository.configuration?.winget;
	if (!policy) return undefined;
	if (data.latestWinget.kind === 'failed') {
		return {
			policy,
			title: 'WinGet manifest',
			entry: { label: winget.label, status: 'Submission status unavailable' },
		};
	}
	const submission = data.latestWinget.value.get(repository.id);
	return {
		policy,
		title: submission?.plan.packageIdentifier ?? 'WinGet manifest',
		entry: manifestEntry(wingetOutcome(submission)),
	};
}
---
<article>
	<h2>Connect a repository</h2>
	<p>
		First install the Beepboop GitHub App on the repository. Inspection reads
		its packages and workflows; the setup pull request lets you review its
		release configuration.
	</p>
	<form
		data-action="discover"
		method="post"
		action="/api/repositories/discover"
		class="form-row"
	>
		<label>
			GitHub repository
			<input
				name="repository"
				placeholder="name, owner/name or GitHub URL"
				required
			>
		</label>
		<button class="primary">Inspect repository</button>
	</form>
</article>
{data.repositories.unreadable.map(row => (
	<article id={`repository-${row.id}`}>
		<div class="section-heading">
			<h2><a href={`https://github.com/${row.name}`}>{row.name} ↗</a></h2>
			<Badge tone="error" label="Record unreadable" />
		</div>
		<pre>{row.error}</pre>
	</article>
))}
{repositories.map(repository => (
	<article id={`repository-${repository.id}`}>
		<details open={repository.name === selected || repositories.length === 1}>
			<summary class="section-heading">
				<h2>{repository.name}</h2>
				<Badge {...repositoryStatus(repository)} />
			</summary>
			<dl class="fields metadata">
				<Field label="Repository">
					<a href={`https://github.com/${repository.name}`}>Open on GitHub ↗</a>
				</Field>
				<Field label="Inspected"><Time value={repository.updatedAt} /></Field>
				{repository.access.kind === 'suspended' && (
					<Field label="App access lost"><Time
							value={repository.access.since}
						/></Field>
				)}
				<Field label="Commit">
					<a
						href={`https://github.com/${repository.name}/commit/${repository.sha}`}
					>
						<code>{repository.sha.slice(0, 12)}</code>
					</a>
				</Field>
			</dl>
			{repository.diagnostics.map(entry => (
				<p class="notice">{entry.message}</p>
			))}
			{publishedOutsideRequired(repository).map(gap => (
				<div class="notice">
					<p>
						Published but not required in <strong>{gap.stream}</strong>. Edit
						release setup proposes adding them.
					</p>
					<ul class="inline-list">
						{gap.packages.map(id => <li>{packageLabel(id)}</li>)}
					</ul>
				</div>
			))}
			<div class="actions">
				<form
					data-action="discover"
					method="post"
					action="/api/repositories/discover"
				>
					<input type="hidden" name="repository" value={repository.name}>
					<button aria-label={`Refresh inspection of ${repository.name}`}>
						Refresh inspection
					</button>
				</form>
				{data.onboarding.get(repository.id) && (
					<a
						class="button"
						href={data.onboarding.get(repository.id)}
						aria-label={`Review setup PR of ${repository.name}`}
					>
						Review setup PR ↗
					</a>
				)}
				{readiness(repository).kind === 'ready' && (
					<a
						class="button primary"
						href={`/releases?repository=${repository.id}`}
						aria-label={`Prepare a release of ${repository.name}`}
					>Prepare a release</a>
				)}
			</div>
			<form
				data-action="setup"
				method="post"
				action="/api/repositories/setup/preview"
				data-repository={repository.name}
				class="release-setup"
			>
				<button class="primary">
					{repository.configuration
						? 'Edit release setup'
						: data.onboarding.get(repository.id)
						? 'Refresh setup proposal'
						: 'Configure releases'}
				</button>
			</form>
			<div class="repository-grid">
				<div>
					<h3>Release packages</h3>
					{listsPackages(repository) ? (
						<table>
							<thead>
								<tr>
									<th>Package</th>
									<th>Destinations</th>
									<th>In repository</th>
								</tr>
							</thead>
							<tbody>
								{repository.inventory.packages.filter(publishable).map(p => (
									<tr>
										<td>
											{packageDisplayName(p)}
											<small>
												<a
													href={`https://github.com/${repository.name}/blob/${repository.sha}/${
														p.manifest.split('/').map(encodeURIComponent).join('/')
													}`}
												>{p.manifest}</a>
											</small>
											{p.previousModule && (
												<small>
													Earlier module: {p.previousModule.name}
													{p.previousModule.version}
												</small>
											)}
										</td>
										<td>
											<ul class="destination-list">
												{packageDestinations(p, repository.name).map(entry => (
													<li>
														{entry.href ? (
															<a href={entry.href}>{entry.label}</a>
														) : entry.label}: {entry.status}
													</li>
												))}
											</ul>
										</td>
										<td>
											{p.version
												?? (p.versionSource.startsWith('tags:')
													? 'No matching release tag'
													: 'No version found')}
										</td>
									</tr>
								))}
								{[wingetDestination(repository)].map(winget => winget && (
									<tr>
										<td>
											<code>{winget.title}</code>
											<small>
												<a
													href={`https://github.com/${repository.name}/blob/${repository.sha}/${
														winget.policy.config.split('/').map(encodeURIComponent).join('/')
													}`}
												>{winget.policy.config}</a>
											</small>
										</td>
										<td>
											{winget.entry.href ? (
												<a href={winget.entry.href}>{winget.entry.label}</a>
											) : winget.entry.label}: {winget.entry.status}
										</td>
										<td>
											Release tags starting with
											<code>{winget.policy.tagPrefix}</code>
										</td>
									</tr>
								))}
								{repositoryChannels(repository.inventory).map((
									{ outcome, entry },
								) => (
									<tr>
										<td>
											<code>{outcome.name}</code>
											<small>
												<a
													href={`https://github.com/${repository.name}/blob/${repository.sha}/${
														outcome.manifest.split('/').map(encodeURIComponent).join('/')
													}`}
												>{outcome.manifest}</a>
											</small>
										</td>
										<td>
											<a href={entry.href}>{entry.label}</a>: {entry.status}
										</td>
										<td>
											{outcome.state === 'tracking' ? 'Default branch' : 'Not linked to a package'}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					) : <p>No publishable packages discovered.</p>}
					{repository.inventory.packages.some(p => !publishable(p)) && (
						<div class="metadata">
							<p>Excluded</p>
							<ul class="inline-list">
								{repository.inventory.packages.filter(p => !publishable(p)).map(p => (
									<li>
										<a
											href={`https://github.com/${repository.name}/blob/${repository.sha}/${
												p.manifest.split('/').map(encodeURIComponent).join('/')
											}`}
										>{p.name}</a>
										({exclusionLabel(p.publication)})
									</li>
								))}
							</ul>
						</div>
					)}
				</div>
				<div>
					<h3>Release workflows</h3>
					{workflowChoices(repository).length ? (
						<ul class="workflow-list">
							{workflowChoices(repository).map(w => (
								<li>
									<strong>{w.stream} / {w.operation}</strong>
									<small>
										<a
											href={`https://github.com/${repository.name}/blob/${repository.sha}/.github/workflows/${w.file}`}
										>{w.file}</a>
									</small>
									<small>Ref: <code>{w.ref}</code></small>
									<small>
										{w.mode === 'observe' ? 'Tracks existing triggers' : 'Can be dispatched'}
									</small>
								</li>
							))}
						</ul>
					) : (
						 <>
							 {repository.configuration && (
								 <p class="notice">No release workflows configured.</p>
							 )}
							 {repository.inventory.workflows.length ? (
								 <ul class="workflow-list">
									 {repository.inventory.workflows.map(workflow => (
										 <li>
											 <strong>
												 <a
													 href={`https://github.com/${repository.name}/blob/${repository.sha}/.github/workflows/${workflow.file}`}
												 >{workflow.name || workflow.file}</a>
											 </strong>
											 <small>
												 {workflow.events.join(', ') || 'No supported triggers'}
											 </small>
										 </li>
									 ))}
								 </ul>
							 ) : <p>No workflows discovered.</p>}
						 </>
					 )}
				</div>
			</div>
			{repository.configuration && (
				<details>
					<summary aria-label={`Publications and automation of ${repository.name}`}>
						Publications and automation
					</summary>
					<dl class="fields">
						{Object.entries(repository.configuration.streams).map((
							[name, stream],
						) => (
							<Field label={name}>
								{stream.required.length ? (
									<ul class="inline-list">
										{stream.required.map(id => <li>{packageLabel(id)}</li>)}
									</ul>
								) : 'No publications configured'}
							</Field>
						))}
					</dl>
					{repository.configuration.subscriptions.map(s => (
						<p>
							When {s.source} emits {s.event}, start {s.stream} / {s.operation}.
						</p>
					))}
				</details>
			)}
			{repository.inventory.diagnostics.map(entry => (
				<p class="notice">{entry.message}</p>
			))}
		</details>
	</article>
))}
