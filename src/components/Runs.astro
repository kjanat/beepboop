---
import Arrow from '@/components/Arrow.astro';
import Badge from '@/components/Badge.astro';
import Commit from '@/components/Commit.astro';
import Field from '@/components/Field.astro';
import RecoverForm from '@/components/RecoverForm.astro';
import RunCard from '@/components/RunCard.astro';
import { packageLabel } from '@/domain/package-label';
import type { ViewOf } from '@/server/loaders.ts';
import {
	releaseSetSummaries,
	releaseSummaries,
	runStateLabel,
} from '@/server/releases';
import { pipeline, progress } from '@/server/views/runs.ts';
import {
	executionTone,
	publicationTone,
	releaseSetTone,
} from '@/server/views/tone.ts';

interface Props {
	data: ViewOf<'runs'>;
}
const { repositories, selected } = Astro.props.data;
const { readable: executions, unreadable } = Astro.props.data.executions;
const now = Date.now();
const latest = Math.max(0, ...executions.map(run => run.updatedAt));
const position = new Map(executions.map((run, index) => [run.id, index]));
const first = (runs: readonly { id: string }[]) =>
	Math.min(...runs.map(run => position.get(run.id) ?? 0));
const pipelines = releaseSummaries(executions).sort((a, b) =>
	first(a.runs) - first(b.runs)
);
---
<span data-runs-latest={latest} data-runs-repository={selected} hidden></span>
{repositories.length > 1 && (
	<nav class="filters" aria-label="Repository">
		<a
			class="filter-link"
			href="/runs"
			aria-current={selected ? undefined : 'page'}
		>
			All repositories
		</a>
		{repositories.map(name => (
			<a
				class="filter-link"
				href={`/runs?repository=${encodeURIComponent(name)}`}
				aria-current={name === selected ? 'page' : undefined}
			>{name}</a>
		))}
	</nav>
)}
{releaseSetSummaries(executions).map(release => (
	<article class="run-card">
		<div class="section-heading">
			<div>
				<p class="eyebrow">{release.repository}</p>
				<h2>Monorepo release</h2>
			</div>
			<Badge tone={releaseSetTone[release.state]} label={release.state} />
		</div>
		<p>
			{release.complete} of {release.total} operations complete. Each package
			group keeps its own version.
		</p>
		<dl class="fields metadata">
			<Field label="Source">
				<Commit
					repository={release.repository}
					sha={release.sourceSha}
					label="Open source commit on GitHub"
				/>
			</Field>
		</dl>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Package group</th>
						<th>Version</th>
						<th>Operation</th>
						<th>Progress</th>
					</tr>
				</thead>
				<tbody>
					{release.runs.map(run => (
						<tr>
							<td>{run.releaseSet?.group}</td>
							<td>{run.version}</td>
							<td>
								{run.operation}
								<Arrow
									href={`#${run.id}`}
									label={`Show the ${run.operation} operation`}
								/>
								{run.package && <small><code>{run.package.id}</code></small>}
							</td>
							<td>{progress(run, now)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{release.error && <p class="notice">{release.error}</p>}
		{release.complete !== release.total && (
			<RecoverForm
				id={release.recoveryId}
				recovery="reconcile"
				label={`Check coordination of ${release.repository} release set`}
			>
				Check coordination
			</RecoverForm>
		)}
		<details>
			<summary>Coordination details</summary>
			<dl class="fields">
				<Field label="Cloudflare Workflow"><code>{release.id}</code></Field>
			</dl>
		</details>
	</article>
))}
{unreadable.map(row => (
	<article class="run-card" id={row.id}>
		<div class="section-heading">
			<div>
				<p class="eyebrow">Repository {row.repositoryId}</p>
				<h2>Execution <code>{row.id.slice(0, 12)}</code></h2>
			</div>
			<Badge tone="error" label="record unreadable" />
		</div>
		<pre>{row.error}</pre>
	</article>
))}
{!executions.length && !unreadable.length && (
	<article class="empty">
		<h2>No release runs yet</h2>
		<p>
			Prepare a release or connect an existing publishing workflow to start
			tracking its results.
		</p>
		<a href="/releases">Prepare a release →</a>
	</article>
)}
{pipelines.map(release => {
	const view = pipeline(release, now);
	if (!view) return release.runs.map(run => <RunCard run={run} now={now} />);
	return (
	 <article class="run-card release-pipeline">
		 <div class="section-heading">
			 <div>
				 <p class="eyebrow">{release.repository} / {release.stream}</p>
				 <h2>Version {release.version}</h2>
			 </div>
			 <Badge tone={view.status.tone} label={view.status.label} />
		 </div>
		 <ol class="pipeline">
			 {view.stages.map(stage => (
				 <li data-tone={stage.tone}>
					 <span
						 class="stage-dot"
						 data-tone={stage.tone}
						 aria-hidden="true"
					 ></span>
					 <span class="stage-text">
						 {stage.run
						 	? <a href={`#${stage.run.id}`}>{stage.operation}</a>
						 	: <span>{stage.operation}</span>}
						 <small>
							 {stage.note}
							 {stage.runHref && (
								 <Arrow
									 href={stage.runHref}
									 label={`Open the ${stage.operation} workflow run on GitHub`}
								 />
							 )}
						 </small>
					 </span>
				 </li>
			 ))}
		 </ol>
		 <details
			 class="release-detail"
			 open={view.open}
			 data-fold={`release:${release.latest.repositoryId}:${release.stream}:${release.version}:${
			 	release.latest.releaseSet?.group ?? ''
			 }`}
		 >
			 <summary class="release-summary">Publications and operations</summary>
			 {!!view.publications.length && (
				 <div class="table-scroll">
					 <table>
						 <thead>
							 <tr>
								 <th>Publication</th>
								 <th>Version</th>
								 <th>Result</th>
							 </tr>
						 </thead>
						 <tbody>
							 {view.publications.map(p => (
								 <tr>
									 <td>
										 {p.label}
										 {p.href && (
											 <Arrow href={p.href} label={`Open ${p.label}`} />
										 )}
										 <small>{p.required ? 'required' : 'optional'}</small>
									 </td>
									 <td>{p.version}</td>
									 <td>
										 <Badge
											 tone={publicationTone[p.outcome]}
											 label={p.outcome}
										 />
									 </td>
								 </tr>
							 ))}
						 </tbody>
					 </table>
				 </div>
			 )}
			 {view.stages.flatMap(stage => stage.runs).map(entry => (
				 <details
					 class="stage-detail"
					 open={entry.open}
					 data-fold={`run:${entry.run.id}`}
				 >
					 <summary class="stage-summary">
						 {entry.run.operation}
						 {entry.run.package && ` ${packageLabel(entry.run.package.id)}`}
						 {entry.earlier && ' (earlier run)'}
						 <Badge
							 tone={executionTone[entry.run.state]}
							 label={runStateLabel(entry.run)}
						 />
					 </summary>
					 <RunCard run={entry.run} now={now} grouped />
				 </details>
			 ))}
		 </details>
	 </article>
 );
})}
