---
import { matchesPublication } from '@/automation/package-identity.ts';
import type { Execution } from '@/automation/types.ts';
import Badge from '@/components/Badge.astro';
import Field from '@/components/Field.astro';
import Time from '@/components/Time.astro';
import { formatTime } from '@/contract/time';
import { defaultTagPolicy, semVer, tagFor } from '@/contract/version';
import { packageLabel } from '@/domain/package-label';
import type { ViewOf } from '@/server/loaders.ts';
import { packageDisplayName } from '@/server/package-name';
import { releaseSetSummaries } from '@/server/releases';
import {
	executionTone,
	publicationTone,
	releaseSetTone,
} from '@/server/views/tone.ts';

interface Props {
	data: ViewOf<'runs'>;
}
const { readable: executions, unreadable } = Astro.props.data.executions;
const now = Date.now();
const waiting = (run: Execution): string | undefined =>
	run.notBefore !== undefined && run.notBefore > now
		&& ['pending', 'ready'].includes(run.state)
		? formatTime(run.notBefore)
		: undefined;
const latest = Math.max(0, ...executions.map(run => run.updatedAt));
const progress = (run: Execution): string => {
	const until = waiting(run);
	return until ? `waiting until ${until}` : run.state;
};
const refTag = (run: Execution, version: string): string => {
	const parsed = semVer.safeParse(version);
	return parsed.success
		? tagFor(run.workflow?.refs ?? defaultTagPolicy, parsed.data)
		: version;
};
---
<span data-runs-latest={latest} hidden></span>
{releaseSetSummaries(executions).map(release => (
	<article class="run-card">
		<div class="section-heading">
			<div>
				<p class="eyebrow">{release.repository}</p>
				<h2>Monorepo release</h2>
			</div>
			<Badge tone={releaseSetTone[release.state]} label={release.state} />
		</div>
		<p>
			{release.complete} of {release.total} operations complete. Each package
			group keeps its own version.
		</p>
		<dl class="fields metadata">
			<Field label="Source">
				<a
					href={`https://github.com/${release.repository}/commit/${release.sourceSha}`}
				>
					<code>{release.sourceSha.slice(0, 12)}</code>
				</a>
			</Field>
		</dl>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th>Package group</th>
						<th>Version</th>
						<th>Operation</th>
						<th>Progress</th>
					</tr>
				</thead>
				<tbody>
					{release.runs.map(run => (
						<tr>
							<td>{run.releaseSet?.group}</td>
							<td>{run.version}</td>
							<td>
								<a href={`#${run.id}`}>{run.operation}</a>
								{run.package && <small><code>{run.package.id}</code></small>}
							</td>
							<td>{progress(run)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
		{release.error && <p class="notice">{release.error}</p>}
		{release.complete !== release.total && (
			<form
				data-action="recover"
				method="post"
				action="/api/executions/recover"
			>
				<input type="hidden" name="id" value={release.recoveryId}>
				<input type="hidden" name="action" value="reconcile">
				<button aria-label={`Check coordination of ${release.repository} release set`}>
					Check coordination
				</button>
			</form>
		)}
		<details>
			<summary>Coordination details</summary>
			<dl class="fields">
				<Field label="Cloudflare Workflow"><code>{release.id}</code></Field>
			</dl>
		</details>
	</article>
))}
{unreadable.map(row => (
	<article class="run-card" id={row.id}>
		<div class="section-heading">
			<div>
				<p class="eyebrow">Repository {row.repositoryId}</p>
				<h2>Execution <code>{row.id.slice(0, 12)}</code></h2>
			</div>
			<Badge tone="error" label="record unreadable" />
		</div>
		<pre>{row.error}</pre>
	</article>
))}
{!executions.length && !unreadable.length && (
	<article class="empty">
		<h2>No release runs yet</h2>
		<p>
			Prepare a release or connect an existing publishing workflow to start
			tracking its results.
		</p>
		<a href="/releases">Prepare a release →</a>
	</article>
)}
{executions.map(run => {
	const preparation = run.managed?.result ?? run.prepared?.result;
	const until = waiting(run);
	const required = run.releaseSet?.required
		?? run.configuration.streams[run.stream]?.required ?? [];
	const runName = [run.repository, run.stream, run.operation, run.version]
		.filter(Boolean).join(' ');
	const approving = run.state === 'blocked' && run.operation === 'promote';
	const automatic = approving
		&& (run.configuration.streams[run.stream]?.promote.approval === 'push'
			|| run.approvedBy === 'merge');
	const missing = required.filter(id =>
		!run.publications.some(p =>
			matchesPublication(id, p) && p.outcome === 'succeeded'
		)
	);
	return (
	 <article class="run-card" id={run.id}>
		 <div class="section-heading">
			 <div>
				 <p class="eyebrow">{run.repository} / {run.stream}</p>
				 <h2>
					 {run.version ? `Version ${run.version}` : 'Workflow operation'}
				 </h2>
			 </div>
			 <Badge tone={executionTone[run.state]} label={run.state} />
		 </div>
		 <p>
			 {approving
			 	? automatic
			 		? `${
			 			run.approvedBy === 'merge' ? 'You merged the preparation PR. ' : ''
			 		}Beepboop releases this commit once it is verified and its checks pass.`
			 		: 'Waiting for your approval.'
			 	: (run.state !== 'succeeded' && run.reason)
			 		|| (run.state === 'succeeded'
			 			? 'This operation completed.'
			 			: 'Follow the workflow and publication results below.')}
		 </p>
		 {until && (
			 <p class="notice">
				 Publishes after {until} to stay within the registry's publish rate
				 limit.
			 </p>
		 )}
		 <dl class="fields metadata">
			 <Field label="Operation">{run.operation}</Field>
			 {run.package && (
				 <Field label="Package">{packageLabel(run.package.id)}</Field>
			 )}
			 <Field label="Commit">
				 <a
					 href={`https://github.com/${run.repository}/commit/${run.sourceSha}`}
				 >
					 <code>{run.sourceSha.slice(0, 12)}</code>
				 </a>
			 </Field>
			 <Field label="Updated"><Time value={run.updatedAt} /></Field>
			 {run.runId && (
				 <Field label="Workflow run">
					 <a
						 href={`https://github.com/${run.repository}/actions/runs/${run.runId}`}
					 >Open on GitHub ↗</a>
				 </Field>
			 )}
		 </dl>
		 {preparation?.url.startsWith('https://github.com/') && (
			 <a class="button" href={preparation.url}>Review preparation PR ↗</a>
		 )}
		 {!!run.publications.length && (
			 <div class="table-scroll">
				 <table>
					 <thead>
						 <tr>
							 <th>Publication</th>
							 <th>Version</th>
							 <th>Result</th>
						 </tr>
					 </thead>
					 <tbody>
						 {run.publications.map(p => (
							 <tr>
								 <td>
									 {p.id.startsWith('refs:')
									 	? `tag ${refTag(run, p.version)}`
									 	: packageDisplayName(p)}
									 <small>{p.required ? 'required' : 'optional'}</small>
								 </td>
								 <td>{p.version}</td>
								 <td>
									 <Badge tone={publicationTone[p.outcome]} label={p.outcome} />
								 </td>
							 </tr>
						 ))}
					 </tbody>
				 </table>
			 </div>
		 )}
		 {!!missing.length && !approving && run.operation !== 'prepare'
		 	&& run.state !== 'cancelled' && (
				<div class="notice">
					<p>Still to publish</p>
					<ul class="inline-list">
						{missing.map(id => <li>{packageLabel(id)}</li>)}
					</ul>
				</div>
			)}
		 {approving && (
			 <form
				 data-action="approve"
				 method="post"
				 action="/api/executions/approve"
				 data-automatic={automatic ? 'true' : undefined}
			 >
				 <input type="hidden" name="id" value={run.id}>
				 <input type="hidden" name="sourceSha" value={run.sourceSha}>
				 <input type="hidden" name="force" value="false">
				 <p>
					 {automatic ? 'Checks on commit' : 'Approve publishing from commit'}
					 <a
						 href={`https://github.com/${run.repository}/commit/${run.sourceSha}`}
					 >
						 <code>{run.sourceSha}</code>
					 </a>
				 </p>
				 <ul class="approval-status" aria-live="polite">
					 <li>Checking the commit signature and checks…</li>
				 </ul>
				 <button class="primary" disabled hidden={automatic}>
					 Approve this commit
				 </button>
			 </form>
		 )}
		 {run.workflow && ['failed', 'cancelled'].includes(run.state)
		 	&& !(run.operation === 'prepare' && !run.plan && !run.managed) && (
				<form
					data-action="recover"
					method="post"
					action="/api/executions/recover"
				>
					<input type="hidden" name="id" value={run.id}>
					<input type="hidden" name="action" value="retry">
					<button aria-label={`Retry ${runName}`}>Retry</button>
				</form>
			)}
		 {run.state === 'uncertain' && (
			 <form
				 data-action="recover"
				 method="post"
				 action="/api/executions/recover"
			 >
				 <input type="hidden" name="id" value={run.id}>
				 <input type="hidden" name="action" value="reconcile">
				 <p>
					 Check whether GitHub accepted the earlier request before attempting
					 another dispatch.
				 </p>
				 <button aria-label={`Check workflow outcome of ${runName}`}>
					 Check workflow outcome
				 </button>
			 </form>
		 )}
		 {!['succeeded', 'cancelled', 'failed'].includes(run.state) && (
			 <form data-action="cancel" method="post" action="/api/executions/cancel">
				 <input type="hidden" name="id" value={run.id}>
				 <button aria-label={`Cancel ${runName}`}>Cancel</button>
			 </form>
		 )}
		 <details>
			 <summary aria-label={`Run details for ${runName}`}>Run details</summary>
			 <dl>
				 <dt>Configuration commit</dt>
				 <dd>
					 <a
						 href={`https://github.com/${run.repository}/commit/${run.configurationSha}`}
					 >
						 <code>{run.configurationSha}</code>
					 </a>
				 </dd>
				 <dt>Workflow commit</dt>
				 <dd>
					 {run.workflowSha
					 	? (
							<a
								href={`https://github.com/${run.repository}/commit/${run.workflowSha}`}
							>
								<code>{run.workflowSha}</code>
							</a>
						)
					 	: 'Not dispatched yet'}
				 </dd>
				 <dt>Run attempt</dt>
				 <dd>{run.runAttempt ?? 'Not started'}</dd>
			 </dl>
			 {!!run.artifacts.length && (
				 <ul class="artifact-list">
					 {run.artifacts.map(a => (
						 <li>
							 {a.name}
							 <code>{a.digest}</code>
						 </li>
					 ))}
				 </ul>
			 )}
		 </details>
	 </article>
 );
})}
