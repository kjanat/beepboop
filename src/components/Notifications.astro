---
import Badge from '@/components/Badge.astro';
import DestinationChoices from '@/components/DestinationChoices.astro';
import Field from '@/components/Field.astro';
import RemoveForm from '@/components/RemoveForm.astro';
import Time from '@/components/Time.astro';
import { notificationKindLabels } from '@/contract/catalog';
import { registryPackageLabel } from '@/domain/package-label';
import type { ViewOf } from '@/server/loaders.ts';
import { notificationsPage } from '@/server/views/notifications.ts';
import { deliveryStatus, destinationStatus } from '@/server/views/tone.ts';

interface Props {
	data: ViewOf<'notifications'>;
}
const { data } = Astro.props;
const { destinations, deliveries } = notificationsPage(data);
---
{!data.keys.length && (
	<p class="notice">
		Before adding a destination,
		<a href="/security">enroll your first security key</a>.
	</p>
)}
{!data.secrets.length && (
	<p class="notice">
		Store each webhook URL as a <a href="/secrets">secret</a> first. A
		destination sends to the URL saved under the secret you choose.
	</p>
)}
<article>
	<h2>Add a destination</h2>
	<form
		data-action="notification-save"
		method="post"
		action="/api/notifications/save"
	>
		<div class="form-grid">
			<label>
				Name
				<input
					name="name"
					placeholder="Slack #releases"
					maxlength="80"
					required
				>
			</label>
			<DestinationChoices secrets={data.secrets} />
		</div>
		<label class="check">
			<input type="checkbox" name="subscribeNew" value="true" checked>
			Notify about newly watched packages
		</label>
		<input type="hidden" name="enabled" value="true">
		<button
			class="primary"
			disabled={!data.keys.length || !data.secrets.length}
		>
			Add destination
		</button>
	</form>
</article>
{destinations.map(destination => (
	<article>
		<div class="section-heading">
			<div>
				<h2>{destination.name}</h2>
				<dl class="fields metadata">
					<Field label="Type">{notificationKindLabels[destination.kind]}</Field>
					<Field label="Secret"><code>{destination.credential}</code></Field>
					<Field label="Packages">{destination.packages}</Field>
				</dl>
			</div>
			<Badge {...destinationStatus(destination.enabled)} />
		</div>
		<details>
			<summary aria-label={`Edit destination ${destination.name}`}>
				Edit destination
			</summary>
			<form
				data-action="notification-save"
				method="post"
				action="/api/notifications/save"
			>
				<input type="hidden" name="id" value={destination.id}>
				<div class="form-grid">
					<label>
						Name
						<input
							name="name"
							value={destination.name}
							maxlength="80"
							required
						>
					</label>
					<DestinationChoices
						secrets={data.secrets}
						kind={destination.kind}
						credential={destination.credential}
					/>
				</div>
				<label class="check">
					<input
						type="checkbox"
						name="subscribeNew"
						value="true"
						checked={destination.subscribeNew}
					>
					Notify about newly watched packages
				</label>
				<label class="check">
					<input
						type="checkbox"
						name="enabled"
						value="true"
						checked={destination.enabled}
					>
					Enabled
				</label>
				<button
					class="primary"
					aria-label={`Save destination ${destination.name}`}
				>
					Save destination
				</button>
			</form>
		</details>
		<RemoveForm
			action="notification-remove"
			endpoint="/api/notifications/remove"
			name="id"
			value={destination.id}
			label={`Remove destination ${destination.name}`}
		>
			Remove destination
		</RemoveForm>
	</article>
))}
<h2>Recent notifications</h2>
<div class="table-scroll">
	<table>
		<thead>
			<tr>
				<th>When</th>
				<th>Package</th>
				<th>Version</th>
				<th>Destination</th>
				<th>Result</th>
			</tr>
		</thead>
		<tbody>
			{deliveries.map(delivery => (
				<tr>
					<td>
						<Time value={delivery.updatedAt} />
					</td>
					<td>
						{registryPackageLabel(
							delivery.payload.package.registry,
							delivery.payload.package.name,
						)}
					</td>
					<td>
						{delivery.payload.version.previous ?? 'new'} →
						{delivery.payload.version.current}
					</td>
					<td>{delivery.destination}</td>
					<td>
						<Badge {...deliveryStatus(delivery)} />
						{delivery.error && <small>{delivery.error}</small>}
					</td>
				</tr>
			))}
			{!deliveries.length && (
				<tr>
					<td colspan="5">
						No notifications yet. They appear here when a watched package
						releases.
					</td>
				</tr>
			)}
		</tbody>
	</table>
</div>
