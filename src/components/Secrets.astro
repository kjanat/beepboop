---
import { type Dashboard, date, workflowChoices } from '@/server/dashboard.ts';

interface Props {
	data: Dashboard;
}
const { data } = Astro.props;
const repositories = data.repositories.filter(r => workflowChoices(r).length);
const configured = repositories.map(r => ({
	id: r.id,
	name: r.name,
	workflows: workflowChoices(r),
}));
---
{!data.keys.length && (
	<p class="notice">
		Before adding or changing secrets, <a href="/security"
		>enroll your first security key</a>. Each sensitive action will ask you to
		touch it.
	</p>
)}
<article>
	<h2>Add a secret</h2>
	<p>
		Give the token a name you recognize. Its value is encrypted before storage.
	</p>
	<form data-action="secret-save" class="form-row">
		<label>Name<input
				name="alias"
				autocomplete="username"
				placeholder="npm-token"
				pattern="[\w\-]{1,64}"
				title="Use 1–64 letters, numbers, underscores, or hyphens. For example: crates-io."
				aria-describedby="secret-name-help"
				maxlength="64"
				required
			></label><label>Secret value<input
				name="value"
				type="password"
				autocomplete="new-password"
				required
			></label><button class="primary" disabled={!data.keys.length}>
			Add secret
		</button>
	</form>
	<p id="secret-name-help" class="metadata">
		Name: 1–64 letters (A–Z, a–z), numbers, underscores, or hyphens. For
		example, use <code>crates-io</code> for a crates.io token.
	</p>
</article>
{!data.secrets.length && (
	<article class="empty">
		<h2>No secrets stored</h2>
		<p>
			Add a publishing token above, then give a configured workflow access.
			Workflows using their registry's trusted publishing may not need a stored
			token.
		</p>
	</article>
)}
{data.secrets.map(secret => {
	const grants = data.grants.filter(g => g.alias === secret.alias);
	return (
	 <article class="secret-card">
		 <div class="section-heading">
			 <div>
				 <h2>{secret.alias}</h2>
				 <p class="metadata">
					 Changed {date(secret.created_at)} · Version {secret.version}
				 </p>
			 </div><span class="badge">{grants.length} workflow permissions</span>
		 </div>
		 <div class="actions">
			 <form data-action="secret-reveal">
				 <input type="hidden" name="alias" value={secret.alias}><button>
					 Reveal for 30 seconds
				 </button><output class="revealed" aria-live="polite"></output>
			 </form>{grants.some(g => g.delivery !== 'runtime') && (
				 <form data-action="secret-sync">
					 <input type="hidden" name="alias" value={secret.alias}><button>
						 Copy latest value to GitHub
					 </button>
				 </form>
			 )}
		 </div>
		 <details>
			 <summary>Replace secret value</summary>
			 <form data-action="secret-save" class="form-row">
				 <input
					 type="text"
					 name="alias"
					 value={secret.alias}
					 autocomplete="username"
					 readonly
					 hidden
				 ><label>New secret value<input
						 name="value"
						 type="password"
						 autocomplete="new-password"
						 required
					 ></label><button>Save new value</button>
			 </form>
			 <p class="hint">
				 Existing permissions stay in place. Copy the new value to GitHub after
				 replacing a synchronized secret.
			 </p>
		 </details>
		 <h3>Workflow access</h3>
		 {grants.length
		 	? grants.map(grant => {
		 		const delivery = data.deliveries.find(d =>
		 			d.grant_id === grant.id && d.version === secret.version
		 		);
		 		return (
				 <div class="grant-row">
					 <div>
						 <strong>{grant.repository} · {grant.operation}</strong><p>
							 {grant.workflow} · <code
							 >{grant.ref}</code>{grant.environment && (
								 <> · Environment: {grant.environment}</>
							 )}
						 </p>
						 <p class="metadata">
							 {grant.delivery === 'runtime'
							 	? 'Workflow fetches the value during its run'
							 	: (
									<>GitHub {grant.delivery} secret <code
										>{grant.secretName}</code> ·
										{delivery?.state === 'succeeded'
											? 'Latest value copied'
											: delivery?.state === 'failed'
											? 'Copy failed — retry copying to GitHub'
											: 'Latest value has not been copied'}</>
								)}
						 </p>
					 </div>
					 <form data-action="grant-revoke" data-delivery={grant.delivery}>
						 <input
							 type="hidden"
							 name="grantId"
							 value={grant.id}
						 ><button class="danger">Remove access</button>
					 </form>
				 </div>
			 );
		 	})
		 	: <p class="hint">No workflows have access to this secret yet.</p>}
		 <details>
			 <summary>Give a workflow access</summary>
			 {repositories.length ? (
				 <form
					 data-action="grant-save"
					 data-repositories={JSON.stringify(configured)}
				 >
					 <input type="hidden" name="alias" value={secret.alias}>
					 <div class="form-grid">
						 <label>Repository<select name="repositoryId" required>
								 <option value="">
									 Choose a repository
								 </option>{repositories.map(r => (
									 <option value={r.id}>{r.name}</option>
								 ))}
							 </select></label><label>Workflow<select
								 name="choice"
								 required
								 disabled
							 >
								 <option value="">Choose a repository first</option>
							 </select></label>
					 </div>
					 <p class="workflow-scope hint">
						 Select a workflow to see its release stream and allowed ref.
					 </p>
					 <label>How should the workflow receive it?<select name="delivery">
							 <option value="runtime">
								 Workflow fetches it during the run
							 </option>
							 <option value="repository">
								 Copy to a GitHub repository secret
							 </option>
							 <option value="environment">
								 Copy to a GitHub environment secret
							 </option>
						 </select></label>
					 <div class="form-grid">
						 <label data-secret-name hidden>GitHub secret name<input
								 name="secretName"
								 placeholder="NPM_TOKEN"
								 pattern="[A-Z_][A-Z0-9_]*"
								 disabled
							 ></label><label>GitHub environment <span class="hint"
							 >optional for runtime; required for environment
								 delivery</span><input
								 name="environment"
								 placeholder="npm"
							 ></label>
					 </div>
					 <p class="delivery-help hint">
						 The workflow must use the credentials Action, and this secret's
						 name must be declared in the selected release stream.
					 </p>
					 <button class="primary">Give workflow access</button>
				 </form>
			 ) : (
					<p>
						First <a href="/repositories"
						>configure a repository's release workflows</a>.
					</p>
				)}
		 </details>
	 </article>
 );
})}
<p class="hint">
	Removing access stops future retrieval through Beepboop. A value already
	copied to GitHub remains there until you delete that GitHub secret. Previously
	issued values cannot be recalled.
</p>
