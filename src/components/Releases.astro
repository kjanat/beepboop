---
import { Effect } from 'effect';
import { packageId, publishablePackages } from '@/automation/package-identity';
import {
	capabilitySentence,
	releasable,
	releaseCapability,
} from '@/automation/release-capability';
import {
	bumpedVersion,
	recommendedVersion,
} from '@/automation/release-version';
import type { Package } from '@/automation/types';
import Arrow from '@/components/Arrow.astro';
import Badge from '@/components/Badge.astro';
import Commit from '@/components/Commit.astro';
import { formatTime } from '@/contract/time';
import type { Status } from '@/contract/views';
import { readiness } from '@/domain/repository';
import type { ViewOf } from '@/server/loaders.ts';
import { packageDisplayName } from '@/server/package-name';
import { workflowChoices } from '@/server/views/workflows.ts';
import { primaryStatus } from '@/ui/destinations';

interface Props {
	data: ViewOf<'releases'>;
}
const { data } = Astro.props;
const available = data.repositories.flatMap(r => {
	const state = readiness(r);
	return state.kind === 'ready' ? [state.repository] : [];
});
const repository =
	available.find(r => String(r.id) === Astro.url.searchParams.get('repository'))
		?? available[0];
const streams = Object.entries(repository?.configuration?.streams ?? {});
const capabilities = new Map(
	repository
		? streams.map((
			[name, configured],
		) => [name, releaseCapability(configured, repository.inventory)])
		: [],
);
const streamName =
	streams.some(([name]) => name === Astro.url.searchParams.get('stream'))
		? (Astro.url.searchParams.get('stream') ?? undefined)
		: (streams.find(([name]) => {
			const found = capabilities.get(name);
			return found !== undefined && releasable(found);
		}) ?? streams[0])?.[0];
const stream = streamName
	? repository?.configuration?.streams[streamName]
	: undefined;
const capability = streamName ? capabilities.get(streamName) : undefined;
const summary = streamName && capability
	? capabilitySentence(streamName, capability)
	: undefined;
const recorded =
	data.executions.filter(e =>
		e.repositoryId === repository?.id && e.stream === streamName && e.version
	).sort((a, b) => b.updatedAt - a.updatedAt)[0];
const workflows = repository
	? workflowChoices(repository).filter(w =>
		w.stream === streamName && w.mode !== 'observe' && !w.ref.includes('*')
	)
	: [];
const packages = repository
	? publishablePackages(repository.inventory.packages, stream?.packages)
	: [];
const [groups, recommended, bumps] = await Effect.runPromise(
	Effect.all([
		Effect.forEach(
			[...new Set(packages.map(p => p.versionSource))],
			(source, index) => {
				const members = packages.filter(p => p.versionSource === source);
				return recommendedVersion(members).pipe(Effect.map(version => ({
					id: `group-${index + 1}`,
					packages: members,
					recommended: version,
				})));
			},
		),
		recommendedVersion(packages),
		Effect.all({
			patch: bumpedVersion(packages, { bump: 'patch' }),
			minor: bumpedVersion(packages, { bump: 'minor' }),
			major: bumpedVersion(packages, { bump: 'major' }),
		}),
	]),
	{ signal: Astro.request.signal },
);
const bump = (kind: 'patch' | 'minor' | 'major') => {
	const version = bumps[kind];
	return version ? ` (${version})` : '';
};
function packageStatuses(pkg: Package): Status[] {
	const published: Status = { tone: 'neutral', label: primaryStatus(pkg) };
	return pkg.version && pkg.version !== pkg.published
		? [published, { tone: 'neutral', label: `Manifest ${pkg.version}` }]
		: [published];
}
const preparations = data.executions.filter(e =>
	e.state === 'succeeded' && e.repositoryId === repository?.id
	&& ((e.managed?.plan && 'groups' in e.managed.plan)
		|| (e.plan && 'groups' in e.plan))
);
---
{!repository ? (
	<article class="empty">
		<h2>Configure a repository first</h2>
		<p>
			A release needs a repository configuration that describes its packages and
			workflows.
		</p>
		<a class="button primary" href="/repositories">Set up a repository</a>
	</article>
) : (
	 <>
		 <form class="selection" method="get" action="/releases">
			 <label>
				 Repository
				 <select name="repository">
					 {available.map(r => (
						 <option value={r.id} selected={r.id === repository.id}>
							 {r.name}
						 </option>
					 ))}
				 </select>
			 </label>
			 <label>
				 Release stream
				 <select name="stream">
					 {streams.map(([name]) => (
						 <option selected={name === streamName}>{name}</option>
					 ))}
				 </select>
			 </label>
			 <button>Choose</button>
		 </form>
		 <p class="hint">
			 A release stream groups packages and workflows that release together.
			 These choices come from this repository's configuration.
		 </p>
		 {capability && !releasable(capability) && (
			 <article data-release={capability.kind}>
				 <h2>
					 {capability.kind === 'observes'
					 	? 'Releases start on GitHub'
					 	: 'No publishing workflow'}
				 </h2>
				 <p>{summary}</p>
				 {recorded && (
					 <p>
						 Last recorded release: {recorded.version}
						 <Arrow
							 href={`/runs#${encodeURIComponent(recorded.id)}`}
							 label={`Open the run of ${recorded.version}`}
						 />
					 </p>
				 )}
				 {capability.kind === 'unpublishable' && (
					 <a
						 class="button"
						 href={`/repositories?repository=${encodeURIComponent(repository.name)}`}
					 >Open release setup</a>
				 )}
			 </article>
		 )}
		 {capability && releasable(capability) && (
			 <article data-release={capability.kind}>
				 <h2>Choose the next version</h2>
				 <p>
					 Releases
					 <Commit
						 repository={repository.name}
						 sha={repository.sha}
						 label="Open commit on GitHub"
					 />. {summary}
				 </p>
				 <form
					 data-action={stream?.versioning === 'independent' ? 'release-set' : 'release-prepare'}
					 method="post"
					 action={stream?.versioning === 'independent'
					 ? '/api/releases/plan-set'
					 : '/api/releases/plan'}
				 >
					 <input type="hidden" name="repositoryId" value={repository.id}>
					 <input type="hidden" name="stream" value={streamName}>
					 {stream?.versioning === 'independent' ? (
						 <>
							 <p>
								 Packages sharing a version source are selected together. Choose
								 a version for each group you want to release.
							 </p>
							 {groups.map(group => (
								 <fieldset
									 data-group={group.id}
									 data-packages={JSON.stringify(group.packages.map(p => packageId(p)))}
								 >
									 <legend>
										 <label class="check">
											 <input type="checkbox" name={`include-${group.id}`}>
											 {group.packages.map(p => p.name).join(', ')}
										 </label>
									 </legend>
									 <ul class="package-list hint">
										 {group.packages.map(pkg => (
											 <li>
												 {packageDisplayName(pkg)}
												 {packageStatuses(pkg).map(status => (
													 <Badge {...status} />
												 ))}
											 </li>
										 ))}
									 </ul>
									 <label>
										 Next version
										 <input
											 name={`version-${group.id}`}
											 placeholder="1.2.3"
											 value={group.recommended}
										 >
									 </label>
								 </fieldset>
							 ))}
							 <h3>Workflows for this release</h3>
							 <p class="hint">
								 Assign each workflow to a selected version group. Required
								 dependencies must also be assigned.
							 </p>
							 {workflows.filter(w => w.operation !== 'prepare').map(w => (
								 <label>
									 {w.operation}
									 <small>{w.file}</small>
									 <select data-operation={w.operation}>
										 <option value="">Do not include</option>
										 {groups.map(group => (
											 <option value={group.id}>
												 {group.packages.map(p => p.name).join(', ')}
											 </option>
										 ))}
									 </select>
								 </label>
							 ))}
						 </>
					 ) : (
							<>
								<ul class="package-list hint">
									{packages.map(pkg => (
										<li>
											{packageDisplayName(pkg)}
											{packageStatuses(pkg).map(status => (
												<Badge {...status} />
											))}
										</li>
									))}
								</ul>
								<div class="form-grid">
									<label>
										Version change
										<select name="versionMode">
											<option value="explicit">Set a version</option>
											<option value="patch">
												Patch — bug fixes{bump('patch')}
											</option>
											<option value="minor">
												Minor — new features{bump('minor')}
											</option>
											<option value="major">
												Major — breaking changes{bump('major')}
											</option>
											<option value="prerelease">Start a prerelease</option>
											<option value="next">Next prerelease</option>
											<option value="stable">
												Promote prerelease to stable
											</option>
										</select>
									</label>
									<label data-explicit>
										Version
										<input
											name="version"
											placeholder="1.2.3"
											value={recommended}
											required
										>
									</label>
									<label data-prerelease hidden>
										Prerelease base
										<select name="base">
											<option>patch</option>
											<option>minor</option>
											<option>major</option>
										</select>
									</label>
									<label data-prerelease hidden>
										Prerelease name
										<input name="identifier" value="alpha">
									</label>
								</div>
							</>
						)}
					 <div class="actions">
						 <button class="primary" name="action" value="prepare">
							 Release
						 </button>
					 </div>
				 </form>
			 </article>
		 )}
		 {!!preparations.length && (
			 <article>
				 <h2>Start a prepared release set</h2>
				 <p>
					 After merging its preparation PR, select the preparation and the full
					 merged commit SHA. Beepboop verifies that the prepared contents match
					 that commit.
				 </p>
				 <form
					 data-action="start-set"
					 method="post"
					 action="/api/releases/start-set"
				 >
					 <label>
						 Preparation
						 <select name="preparationId">
							 {preparations.map(e => (
								 <option value={e.id}>
									 {`${e.repository} (${e.stream}) ${formatTime(e.createdAt)}`}
								 </option>
							 ))}
						 </select>
					 </label>
					 <label>
						 Merged commit
						 <input name="sourceSha" pattern="[a-f0-9]{40}" required>
					 </label>
					 <button>Start prepared workflows</button>
				 </form>
			 </article>
		 )}
	 </>
 )}
