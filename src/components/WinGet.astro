---
import Badge from '@/components/Badge.astro';
import Field from '@/components/Field.astro';
import Time from '@/components/Time.astro';
import { blocking } from '@/contract/diagnostics';
import type { ViewOf } from '@/server/loaders.ts';
import { submissionTone } from '@/server/views/tone.ts';
import { submissionLabels } from '@/ui/destinations';

interface Props {
	data: ViewOf<'winget'>;
}
const { data } = Astro.props;
const repositories = data.repositories.filter(repo =>
	repo.configuration?.winget && !repo.suspended
	&& !blocking(repo.diagnostics).length
);
---
<div class="winget">
	{!data.ready && (
		<article class="panel">
			<h2>Connect the submission bot</h2>
			<p>
				The service needs a GitHub token for the submission identity and a fork
				of microsoft/winget-pkgs. An administrator must configure
				WINGET_GITHUB_TOKEN and WINGET_FORK before submissions can be opened.
			</p>
		</article>
	)}
	<article class="panel">
		<h2>Submit a published release</h2>
		<p>
			Choose a release, review its manifests, then ask the bot to open a pull
			request in microsoft/winget-pkgs. Microsoft reviews and merges
			submissions.
		</p>
		{repositories.length ? (
			<form
				data-action="winget-submit"
				method="post"
				action="/api/winget/preview"
			>
				<div class="form-grid">
					<label>
						Repository
						<select name="repositoryId" required>
							<option value="">Choose a repository</option>
							{repositories.map(repo => (
								<option value={repo.id}>{repo.name}</option>
							))}
						</select>
					</label>
					<label>
						Release
						<select name="releaseId" required disabled>
							<option value="">Choose a repository first</option>
						</select>
					</label>
				</div>
				<button type="submit" value="preview">Preview manifests</button>
				<button
					type="submit"
					value="submit"
					disabled
					data-submit-ready={data.ready}
				>
					Submit to WinGet
				</button>
				<div class="plan-result" aria-live="polite"></div>
			</form>
		) : (
			 <p>
				 Add a <code>winget</code> section to your repository’s
				 <code>.github/beepboop.json</code>, merge it, and refresh the
				 repository to enable submissions.
			 </p>
		 )}
		<details>
			<summary>Repository configuration</summary>
			<pre>{JSON.stringify({ winget: { config: 'distribution/winget.json', tagPrefix: 'v', automatic: false } }, null, 2)}</pre>
			<p>
				The config file contains package metadata and installer asset templates.
				Enable automatic to submit future stable releases after setup.
				Historical releases remain available for manual preview.
			</p>
		</details>
	</article>
	<section aria-label="WinGet submissions">
		<div class="section-heading">
			<h2>Submissions</h2>
			<form
				data-action="winget-refresh"
				method="post"
				action="/api/winget/refresh"
			>
				<button>Refresh PR status</button>
			</form>
		</div>
		{data.submissions.kind === 'failed' && (
			<p class="notice">WinGet submissions could not be loaded.</p>
		)}
		{data.submissions.kind === 'loaded' && !data.submissions.value.length
			&& <p>No WinGet submissions yet.</p>}
		{data.submissions.kind === 'loaded'
			&& data.submissions.value.map(item => (
			 <article class="panel">
				 <h3>{item.plan.packageIdentifier} {item.plan.version}</h3>
				 <dl class="metadata-grid">
					 <Field label="Repository">{item.plan.repository}</Field>
					 <Field label="Tag"><code>{item.plan.tag}</code></Field>
					 <Field label="Status">
						 <Badge
							 tone={submissionTone[item.state]}
							 label={submissionLabels[item.state]}
						 />
					 </Field>
					 <Field label="Updated"><Time value={item.updatedAt} /></Field>
					 {item.checks && <Field label="Validation">{item.checks}</Field>}
				 </dl>
				 {item.url && (
					 <a href={item.url} target="_blank" rel="noreferrer">
						 Open submission #{item.number}
					 </a>
				 )}
				 {item.reviews && <p>{item.reviews}</p>}
				 {item.reason && <p class="hint">{item.reason}</p>}
				 {(item.state === 'failed' || item.state === 'pending') && (
					 <form
						 data-action="winget-retry"
						 method="post"
						 action="/api/winget/submit"
					 >
						 <input
							 type="hidden"
							 name="repositoryId"
							 value={item.plan.repositoryId}
						 >
						 <input type="hidden" name="releaseId" value={item.plan.releaseId}>
						 <input type="hidden" name="digest" value={item.plan.digest}>
						 <button
							 disabled={!data.ready}
							 aria-label={`Retry submission of ${item.plan.packageIdentifier} ${item.plan.version}`}
						 >
							 Retry submission
						 </button>
					 </form>
				 )}
				 <details>
					 <summary aria-label={`Submitted manifests and source commit of ${item.plan.packageIdentifier} ${item.plan.version}`}>
						 Submitted manifests and source commit
					 </summary>
					 <p>
						 <a
							 href={`https://github.com/${item.plan.repository}/commit/${item.plan.sourceSha}`}
						 >
							 <code>{item.plan.sourceSha}</code>
						 </a>
					 </p>
					 {Object.entries(item.plan.files).map(([path, content]) => (
						 <details>
							 <summary>{path}</summary>
							 <pre>{content}</pre>
						 </details>
					 ))}
				 </details>
			 </article>
		 ))}
	</section>
</div>
