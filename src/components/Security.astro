---
import RemoveForm from '@/components/RemoveForm.astro';
import Time from '@/components/Time.astro';
import type { ViewOf } from '@/server/loaders.ts';

interface Props {
	data: ViewOf<'security'>;
}
const { data } = Astro.props;
---
<article>
	<h2>
		{data.keys.length
			? 'Add a backup security key'
			: 'Enroll your first security key'}
	</h2>
	<p>
		{data.keys.length
			? 'Touch an enrolled key to authorize adding another, then touch the new key when your browser asks.'
			: 'Your signed-in administrator session can enroll the first key. Your browser will ask you to touch it.'}
	</p>
	<form
		data-action="key-enroll"
		method="post"
		action="/api/authenticators/options"
		data-first={String(!data.keys.length)}
		class="form-row"
	>
		<label>
			Key name
			<input name="label" placeholder="Primary YubiKey" required>
		</label>
		<button class="primary">Enroll security key</button>
	</form>
</article>
{data.keys.map(key => (
	<article class="section-heading">
		<div>
			<h2>{key.label}</h2>
			<p>
				{data.keys.length === 1
					? 'Keep this key: at least one must remain enrolled.'
					: 'Available to authorize secret and access changes.'}
			</p>
		</div>
		{data.keys.length > 1 && (
			<RemoveForm
				action="key-remove"
				endpoint="/api/authenticators/remove"
				name="id"
				value={key.id}
				label={`Remove key ${key.label}`}
			>
				Remove key
			</RemoveForm>
		)}
	</article>
))}
<article>
	<div class="section-heading">
		<h2>CLI logins</h2>
		{!!data.cliSessions.length && (
			<form
				data-action="cli-revoke-all"
				method="post"
				action="/api/cli-sessions/revoke-all"
			>
				<button class="danger">Revoke all CLI logins</button>
			</form>
		)}
	</div>
	<p>Each login lasts until it is revoked here or with beepboop auth logout.</p>
	{data.cliSessions.length ? (
		<ul class="session-list">
			{data.cliSessions.map(session => (
				<li class="section-heading">
					<span>
						Signed in <Time value={session.created_at} />
						<code>{session.id.slice(0, 12)}</code>
					</span>
					<RemoveForm
						action="cli-revoke"
						endpoint="/api/cli-sessions/revoke"
						name="id"
						value={session.id}
						label={`Revoke CLI login ${session.id.slice(0, 12)}`}
					>
						Revoke
					</RemoveForm>
				</li>
			))}
		</ul>
	) : <p>No CLI logins.</p>}
</article>
