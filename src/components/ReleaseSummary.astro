---
import Badge from '@/components/Badge.astro';
import Field from '@/components/Field.astro';
import { packageLabel } from '@/domain/package-label';
import type { releaseSummaries } from '@/server/releases.ts';
import {
	executionTone,
	publicationTone,
	releaseStatus,
} from '@/server/views/tone.ts';

interface Props {
	releases: ReturnType<typeof releaseSummaries>;
}
const { releases } = Astro.props;
---
{releases.map(release => (
	<article>
		<div class="section-heading">
			<div>
				<p class="eyebrow">{release.repository} / {release.stream}</p>
				<h2>
					{release.version ? `Version ${release.version}` : 'Release preparation'}
				</h2>
			</div>
			<Badge {...releaseStatus(release)} />
		</div>
		<dl class="fields metadata">
			<Field label="Commit">
				<a
					href={`https://github.com/${release.repository}/commit/${release.commit}`}
				>
					<code>{release.commit.slice(0, 12)}</code>
				</a>
			</Field>
		</dl>
		{release.publications.length ? (
			<>
				<p>
					<strong>{release.verified} of {release.publications.length}</strong>
					required publications verified.
				</p>
				<ul class="publication-list">
					{release.publications.map(p => (
						<li>
							{packageLabel(p.id)}
							<Badge tone={publicationTone[p.outcome]} label={p.outcome} />
						</li>
					))}
				</ul>
			</>
		) : (
			 <p class="hint">
				 No required publications are configured for this stream. Workflow
				 success alone does not establish release completeness.
			 </p>
		 )}
		<ul class="run-links">
			{release.runs.map(run => (
				<li>
					<a class="run-link" href={`/runs#${run.id}`}>
						{run.operation}
						<Badge tone={executionTone[run.state]} label={run.state} />
					</a>
				</li>
			))}
		</ul>
	</article>
))}
