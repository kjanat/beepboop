{
	"description": "Keep Beepboop GitHub Actions on the rolling v1 tag without SHA pins.",
	"packageRules": [
		{
			"matchManagers": [
				"github-actions"
			],
			"matchDepTypes": [
				"action"
			],
			"matchPackageNames": [
				"kjanat/beepboop"
			],
			"pinDigests": false,
			"enabled": false
		}
	]
}
