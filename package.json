{
	"name": "beepboop",
	"private": true,
	"type": "module",
	"imports": {
		"#pkg": "./package.json",
		"#*": "./src/*.ts",
		"#$*": "./*"
	},
	"scripts": {
		"app:manifest": "bun scripts/app-manifest.ts",
		"check:automation-bundle": "wrangler deploy --config wrangler.automation.jsonc --dry-run --outdir .dry-run-automation",
		"check:bundle": "wrangler deploy --dry-run --outdir .dry-run",
		"discover": "bun scripts/discover.ts",
		"format": "mise exec -- dprint fmt",
		"lint": "biome check . --error-on-warnings",
		"test": "bun test",
		"test:automation-runtime": "node scripts/runtime-automation.ts",
		"test:runtime": "node scripts/runtime-smoke.ts && node scripts/runtime-flow.ts",
		"typecheck": "tsc --noEmit",
		"types": "bun scripts/types.ts"
	},
	"dependencies": {
		"@openauthjs/openauth": "^0.4.3",
		"@simplewebauthn/server": "^14.0.3",
		"cron-parser": "^5.10.2",
		"jose": "6.2.13",
		"smol-toml": "^1.9.1",
		"tweetnacl-sealedbox-js": "^1.2.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@types/bun": "1.4.3",
		"libsodium-wrappers": "^0.8.4",
		"miniflare": "5.20261019.0-beta",
		"typescript": "7.0.2",
		"wrangler": "4.151.3"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.3"
		}
	}
}
