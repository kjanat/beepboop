  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "miniflare": "5.20261019.0-beta",
    "typescript": "7.0.2",
    "wrangler": "4.151.2"
  }
}
