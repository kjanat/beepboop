{
	"name": "beepboop",
	"private": true,
	"description": "Coordinate repository releases through Beepboop",
	"homepage": "https://beepboop.kjanat.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/kjanat/beepboop.git"
	},
	"type": "module",
	"bin": {
		"beepboop": "src/cli/cli.ts",
		"winget": "src/distribution/winget/cli.ts"
	},
	"scripts": {
		"app:manifest": "./scripts/app-manifest.ts",
		"astro": "astro",
		"beepboop": "bun src/cli/cli.ts",
		"prebuild": "run -s types check",
		"build": "astro build",
		"build:cli": "bun src/tooling/cli/build.ts",
		"precheck": "run -s types sync",
		"check": "tsc --noEmit --runExternalCode && tsc --noEmit --runExternalCode -p src/ui/browser/tsconfig.json",
		"check:cli": "bun src/tooling/cli/check.ts",
		"check:jsr": "bunx jsr publish --config packages/cli/jsr.json --dry-run --allow-dirty",
		"db:local": "wrangler d1 migrations apply beepboop --local --config wrangler.toml",
		"db:migrate": "wrangler d1 migrations apply beepboop --remote --config wrangler.toml",
		"predeploy": "run -s build db:migrate",
		"deploy": "wrangler deploy --config dist/server/wrangler.json",
		"predeploy:dry": "rm -rf .dry-run && run build",
		"deploy:dry": "wrangler deploy --config dist/server/wrangler.json --dry-run --outdir .dry-run",
		"predev": "run -pk types db:local",
		"dev": "astro dev",
		"discover": "./scripts/discover.ts",
		"fmt": "kfmt",
		"lint": "biome check . --error-on-warnings",
		"prepare": "run -qs types sync",
		"prepreview": "wrangler types",
		"preview": "astro preview",
		"purl:check": "bun src/tooling/purl/generate.ts --check",
		"purl:fetch": "bun src/tooling/purl/fetch.ts",
		"purl:generate": "bun src/tooling/purl/generate.ts",
		"purl:update": "run -s purl:fetch purl:generate",
		"schema:check": "bun src/tooling/schema/generate.ts --check",
		"schema:generate": "bun src/tooling/schema/generate.ts",
		"prestart": "wrangler types",
		"start": "astro dev",
		"sync": "astro sync",
		"test": "bun test --check",
		"types": "wrangler types >/dev/null",
		"winget": "bun src/distribution/winget/cli.ts"
	},
	"overrides": {
		"wrangler": "4.157.0"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.4",
		"@cfworker/json-schema": "^4.1.4",
		"@kjanat/dreamcli": "^5.0.0",
		"@kjanat/openauth": "^0.6.0",
		"@simplewebauthn/server": "^14.0.3",
		"astro": "^7.4.5",
		"cron-parser": "^5.10.3",
		"github-up": "^0.1.4",
		"jose": "6.2.15",
		"jsonc-parser": "^3.3.1",
		"packageurl-js": "^2.0.1",
		"remark": "15.0.1",
		"remark-gfm": "4.0.1",
		"smol-toml": "^1.9.1",
		"strip-markdown": "6.0.0",
		"tweetnacl-sealedbox-js": "^1.2.0",
		"yaml": "^2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/ts-content-mapper": "^0.2.0",
		"@biomejs/biome": "2.6.5",
		"@kjanat/fmt": "^0.60.6",
		"@types/bun": "1.4.4",
		"@types/mdast": "4.0.4",
		"json-schema-to-typescript": "^16.0.0",
		"jsr": "^0.14.3",
		"libsodium-wrappers": "^0.8.4",
		"miniflare": "5.20261019.0-beta",
		"runner-run": "^0.28.0",
		"tsdown": "^0.23.5",
		"typescript": "^7.1.0-beta",
		"wrangler": "4.157.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4"
		}
	},
	"trustedDependencies": [
		"@kprint/kprint",
		"esbuild",
		"workerd"
	]
}
