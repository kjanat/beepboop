{
	"name": "beepboop",
	"private": true,
	"description": "Coordinate repository releases through Beepboop",
	"homepage": "https://beepboop.kjanat.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/kjanat/beepboop.git"
	},
	"type": "module",
	"bin": {
		"beepboop": "src/cli/cli.ts",
		"winget": "src/distribution/winget/cli.ts"
	},
	"scripts": {
		"actions:check": "bun src/tooling/actions/bundle.ts --check",
		"app:manifest": "./scripts/app-manifest.ts",
		"astro": "astro",
		"beepboop": "bun src/cli/cli.ts",
		"prebuild": "run -s types check",
		"build": "astro build",
		"build:cli": "bun src/tooling/cli/build.ts",
		"precheck": "run -s types sync",
		"check": "tsc --noEmit --runExternalCode && tsc --noEmit --runExternalCode -p src/ui/browser/tsconfig.json && tsc --noEmit --runExternalCode -p browser/tsconfig.json",
		"check:cli": "bun src/tooling/cli/check.ts",
		"check:jsr": "DENO_DISABLE_PEDANTIC_NODE_WARNINGS=true deno publish --unstable-bare-node-builtins --unstable-sloppy-imports --unstable-byonm --no-check --config packages/cli/jsr.json --dry-run --allow-dirty",
		"db:local": "bun src/tooling/database/migrate.ts --local",
		"db:migrate": "bun src/tooling/database/migrate.ts --remote",
		"predeploy": "run -s build db:migrate",
		"deploy": "wrangler deploy --config dist/server/wrangler.json",
		"predeploy:dry": "rm -rf .dry-run && run build",
		"deploy:dry": "wrangler deploy --config dist/server/wrangler.json --dry-run --outdir .dry-run",
		"predev": "run -pk types db:local",
		"dev": "astro dev",
		"discover": "./scripts/discover.ts",
		"fmt": "kfmt",
		"gate": "run -pk check lint test purl:check schema:check actions:check && run -s build:cli check:cli check:jsr",
		"homebrew": "bun src/distribution/homebrew/cli.ts",
		"lint": "biome check . --error-on-warnings",
		"prepare": "run -qs types sync && effect-tsgo patch --typescript --oxlint",
		"prepreview": "wrangler types",
		"preview": "astro preview",
		"purl:check": "bun src/tooling/purl/generate.ts --check",
		"purl:fetch": "bun src/tooling/purl/fetch.ts",
		"purl:generate": "bun src/tooling/purl/generate.ts",
		"purl:update": "run -s purl:fetch purl:generate",
		"schema:check": "bun src/tooling/schema/generate.ts --check",
		"schema:generate": "bun src/tooling/schema/generate.ts",
		"scoop": "bun src/distribution/scoop/cli.ts",
		"prestart": "run -pk types db:local",
		"start": "astro dev",
		"sync": "astro sync",
		"test": "bun test --check",
		"test:browser": "playwright test --config browser/playwright.config.ts",
		"types": "wrangler types >/dev/null",
		"winget": "bun src/distribution/winget/cli.ts"
	},
	"overrides": {
		"wrangler": "4.161.0"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.4",
		"@cfworker/json-schema": "^4.1.6",
		"@kjanat/dreamcli": "^5.0.0",
		"@kjanat/openauth": "^0.6.0",
		"@simplewebauthn/server": "^14.0.3",
		"astro": "^7.4.5",
		"cron-parser": "^5.10.3",
		"effect": "^4.1.2",
		"github-up": "^0.1.4",
		"jsonc-parser": "^3.3.1",
		"micro509": "https://pkg.pr.new/micro509@9200bce",
		"packageurl-js": "^2.0.1",
		"remark": "15.0.1",
		"remark-gfm": "4.0.1",
		"smol-toml": "^1.9.1",
		"strip-markdown": "6.0.0",
		"tweetnacl-sealedbox-js": "^1.2.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@astrojs/ts-content-mapper": "0.2.0",
		"@biomejs/biome": "2.6.7",
		"@effect/tsgo": "0.67.5",
		"@kjanat/fmt": "0.62.0",
		"@playwright/test": "1.65.1",
		"@types/bun": "1.4.4",
		"@types/mdast": "4.0.4",
		"ansispeck": "0.4.3",
		"happy-dom": "21.0.4",
		"jose": "6.2.17",
		"json-schema-to-typescript": "16.0.0",
		"libsodium-wrappers": "0.8.4",
		"miniflare": "5.20261019.0-beta",
		"oxlint": "1.92.0",
		"oxlint-tsgolint": "7.0.2007",
		"runner-run": "0.28.0",
		"tsdown": "0.23.7",
		"typescript": "7.1.0-beta",
		"wrangler": "4.161.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4"
		}
	},
	"trustedDependencies": [
		"@kprint/kprint",
		"esbuild",
		"workerd"
	]
}
