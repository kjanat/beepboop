{
	"name": "beepboop",
	"private": true,
	"type": "module",
	"scripts": {
		"app:manifest": "./scripts/app-manifest.ts",
		"astro": "astro",
		"prebuild": "run -s types check",
		"build": "astro build",
		"check": "astro check",
		"db:local": "wrangler d1 migrations apply beepboop --local --config wrangler.toml",
		"predeploy": "run build",
		"deploy": "wrangler deploy --config dist/server/wrangler.json",
		"deploy:dry": "run deploy --dry-run --outdir .dry-run",
		"predev": "run -pk types db:local",
		"dev": "astro dev",
		"discover": "./scripts/discover.ts",
		"fmt": "kfmt",
		"lint": "biome check . --error-on-warnings",
		"prepare": "run -qs types sync",
		"precheck": "run -s types sync",
		"prepreview": "wrangler types",
		"preview": "astro preview",
		"prestart": "wrangler types",
		"start": "astro dev",
		"sync": "astro sync",
		"pretest": "run winget:build",
		"test": "bun test",
		"test:runtime": "node scripts/runtime.ts",
		"types": "wrangler types >/dev/null",
		"winget": "./scripts/winget.ts",
		"winget:build": "bun build scripts/winget.ts --target=node --format=esm --minify --outfile dist/winget/cli.mjs"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14.4.4",
		"@openauthjs/openauth": "^0.4.3",
		"@simplewebauthn/server": "^14.0.3",
		"astro": "^7.4.5",
		"cron-parser": "^5.10.3",
		"jose": "6.2.15",
		"remark": "15.0.1",
		"remark-gfm": "4.0.1",
		"smol-toml": "^1.9.1",
		"strip-markdown": "6.0.0",
		"tweetnacl-sealedbox-js": "^1.2.0",
		"yaml": "^2.9.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "2.6.4",
		"@kjanat/fmt": "^0.60.6",
		"@types/bun": "1.4.4",
		"@types/mdast": "4.0.4",
		"libsodium-wrappers": "^0.8.4",
		"miniflare": "5.20261019.0-beta",
		"runner-run": "^0.28.0",
		"typescript": "^6.0.3",
		"typescript-native": "npm:typescript@7.0.2",
		"wrangler": "4.156.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4"
		}
	},
	"trustedDependencies": [
		"@kprint/kprint",
		"esbuild",
		"workerd"
	]
}
