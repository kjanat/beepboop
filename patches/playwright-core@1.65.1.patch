diff --git a/bin/reinstall_chrome_beta_linux.sh b/bin/reinstall_chrome_beta_linux.sh
index 13d55dfaacaae405bff7a9824cf75d6b99a10eb7..493abc8d4a151c0f6ce85d04ab2df153735deb4f 100755
--- a/bin/reinstall_chrome_beta_linux.sh
+++ b/bin/reinstall_chrome_beta_linux.sh
@@ -2,12 +2,13 @@
 set -e
 set -x
 
-if [[ $(arch) == "aarch64" ]]; then
+architecture=$(arch)
+if [[ ${architecture} == "aarch64" ]]; then
   echo "ERROR: not supported on Linux Arm64"
   exit 1
 fi
 
-if [ -z "$PLAYWRIGHT_HOST_PLATFORM_OVERRIDE" ]; then
+if [[ -z "${PLAYWRIGHT_HOST_PLATFORM_OVERRIDE}" ]]; then
   if [[ ! -f "/etc/os-release" ]]; then
     echo "ERROR: cannot install on unknown linux distribution (/etc/os-release is missing)"
     exit 1
@@ -15,13 +16,14 @@ if [ -z "$PLAYWRIGHT_HOST_PLATFORM_OVERRIDE" ]; then
 
   ID=$(bash -c 'source /etc/os-release && echo $ID')
   if [[ "${ID}" != "ubuntu" && "${ID}" != "debian" ]]; then
-    echo "ERROR: cannot install on $ID distribution - only Ubuntu and Debian are supported"
+    echo "ERROR: cannot install on ${ID} distribution - only Ubuntu and Debian are supported"
     exit 1
   fi
 fi
 
 # 1. make sure to remove old beta if any.
-if dpkg --get-selections | grep -q "^google-chrome-beta[[:space:]]*install$" >/dev/null; then
+selections=$(dpkg --get-selections google-chrome-beta)
+if grep -q "^google-chrome-beta[[:space:]]*install$" <<<"${selections}"; then
   apt-get remove -y google-chrome-beta
 fi
 
