{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "beepboop",
	"account_id": "83a61abe8741defe835d035b1f4e49af",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-20",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [
		{
			"pattern": "beepboop.kjanat.dev",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true
		}
	},
	"triggers": {
		"crons": [
			"*/10 * * * *"
		]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "AUTOMATION",
				"class_name": "AutomationCoordinator"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"ReleaseCoordinator"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"AutomationCoordinator"
			],
			"deleted_classes": [
				"ReleaseCoordinator"
			]
		}
	],
	"vars": {
		"APPLICATION_ORIGIN": "https://beepboop.kjanat.dev",
		"OPENAUTH_ISSUER": "https://auth.kjanat.com",
		"OPENAUTH_CLIENT_ID": "beepboop",
		"OWNER_ID": "6353477",
		"ADMIN_SUBJECT": "57513d5461547c30a38d12deeed83320",
		"VAULT_ACTIVE_KEY": "v1"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "beepboop",
			"database_id": "19241404-a424-4771-8093-0c13a22b0958",
			"migrations_dir": "migrations"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	]
}
