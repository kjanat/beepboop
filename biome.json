{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"files": {
		"includes": [
			"src/**",
			"scripts/**",
			"actions/**",
			"test/**",
			"browser/**",
			"!test/fixtures",
			"*.json",
			"!worker-configuration.d.ts",
			"!**/dist",
			"!**/*.y*ml",
			"!!**/.claude"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"domains": { "playwright": "none" },
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": {
					"level": "error",
					"options": {
						"style": "separatedType"
					}
				},
				"useExportType": {
					"level": "error",
					"options": {
						"style": "separatedType"
					}
				}
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{ "includes": ["browser/**"], "linter": { "domains": { "playwright": "recommended" } } },
		{
			"includes": [
				"**/*.astro"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedImports": "off",
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": [
				"test/**"
			],
			"linter": {
				"rules": {
					"preset": "none",
					"style": {
						"useImportType": {
							"level": "error",
							"options": {
								"style": "separatedType"
							}
						},
						"useExportType": {
							"level": "error",
							"options": {
								"style": "separatedType"
							}
						}
					}
				}
			}
		}
	]
}
